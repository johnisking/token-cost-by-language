) + ' CLEAR!', 'Press Space or click for next level']);\n  else if (state === 'gameover') drawCenterText(['GAME OVER', 'Score: ' + score + ' — Space or click to restart']);\n  else if (state === 'win') drawCenterText(['YOU WIN!', 'Score: ' + score + ' — Space or click to play again']);\n}\n\nfunction loop() {\n  update();\n  draw();\n  requestAnimationFrame(loop);\n}\n\nloadLevel(0);\nstate = 'start';\nloop();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01K3Q158czW8aZK6vBJNQviM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
