diff --git a/packages/zod/src/v4/classic/tests/default.test.ts b/packages/zod/src/v4/classic/tests/default.test.ts
index d7ff8b4..bda1632 100644
--- a/packages/zod/src/v4/classic/tests/default.test.ts
+++ b/packages/zod/src/v4/classic/tests/default.test.ts
@@ -1,6 +1,20 @@
 import { expect, expectTypeOf, test } from "vitest";
 import { z } from "zod/v4";
 
+test("default factory runs once per parse inside an object", () => {
+  let calls = 0;
+  const schema = z.object({
+    a: z.string().default(() => {
+      calls++;
+      return "default";
+    }),
+  });
+  expect(schema.parse({})).toEqual({ a: "default" });
+  expect(calls).toBe(1);
+  schema.parse({});
+  expect(calls).toBe(2);
+});
+
 test("basic defaults", () => {
   expect(z.string().default("default").parse(undefined)).toBe("default");
 });
