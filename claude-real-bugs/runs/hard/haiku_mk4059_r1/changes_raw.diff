+    it('should keep emphasis in a rejected reflink', () => {
+      // the reflink's text was masked for em/strong before it was rejected, so the
+      // re-scan as text must see the delimiters again
+      const ref = '\n\n[ref]: /uri';
+      assert.strictEqual(
+        marked.parse(`[foo *bar [baz](/url) qux*][ref]${ref}`).trim(),
+        '<p>[foo <em>bar <a href="/url">baz</a> qux</em>]<a href="/uri">ref</a></p>',
+      );
+      assert.strictEqual(
+        marked.parse(`[foo _bar [baz](/url) qux_][ref]${ref}`).trim(),
+        '<p>[foo <em>bar <a href="/url">baz</a> qux</em>]<a href="/uri">ref</a></p>',
+      );
+      assert.strictEqual(
+        marked.parse(`[foo **bar [baz](/url) qux**][ref]${ref}`).trim(),
+        '<p>[foo <strong>bar <a href="/url">baz</a> qux</strong>]<a href="/uri">ref</a></p>',
+      );
+      assert.strictEqual(
+        marked.parse(`[foo *bar [baz][ref] qux*][ref]${ref}`).trim(),
+        '<p>[foo <em>bar <a href="/uri">baz</a> qux</em>]<a href="/uri">ref</a></p>',
+      );
+    });
