+class UnboundCallTest(unittest.TestCase):
+    def test_class_access_with_instance(self):
+        class Example:
+            def __init__(self):
+                self.cache = Cache(2)
+
+            @cachedmethod(lambda self: self.cache)
+            def value(self, number):
+                return number * 2
+
+        example = Example()
+        self.assertEqual(example.value(3), 6)
+        self.assertEqual(Example.value(example, 3), 6)
+        # the instance's cache is used
+        self.assertEqual(len(example.cache), 1)
