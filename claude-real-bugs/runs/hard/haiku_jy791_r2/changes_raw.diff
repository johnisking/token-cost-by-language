diff --git a/test/core/parser/parser.test.mjs b/test/core/parser/parser.test.mjs
index f75c419..ed99676 100644
--- a/test/core/parser/parser.test.mjs
+++ b/test/core/parser/parser.test.mjs
@@ -22,4 +22,22 @@ describe('parser', () => {
       [{ a: null }, { x: 1 }]
     )
   })
+
+  it('ignores a leading byte order mark when computing indentation', () => {
+    const bom = '﻿'
+    const source = 'abc: 5\ncba:\n  - Xyz\n  - Zyx\n'
+
+    assert.deepEqual(
+      loadAll(bom + source)[0],
+      loadAll(source)[0]
+    )
+    assert.deepEqual(
+      loadAll(bom + source)[0],
+      { abc: 5, cba: ['Xyz', 'Zyx'] }
+    )
+    assert.deepEqual(
+      loadAll(bom + '- a\n- b\n')[0],
+      ['a', 'b']
+    )
+  })
 })
