+test("function default runs once inside an object", () => {
+  let calls = 0;
+  const schema = z.object({
+    a: z.string().default(() => {
+      calls++;
+      return "x";
+    }),
+  });
+  expect(schema.parse({})).toEqual({ a: "x" });
+  expect(calls).toBe(1);
+});
