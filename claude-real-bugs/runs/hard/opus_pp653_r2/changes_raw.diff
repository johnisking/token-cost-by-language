diff --git a/pyparsing/helpers.py b/pyparsing/helpers.py
index c88e543..7e8971e 100644
--- a/pyparsing/helpers.py
+++ b/pyparsing/helpers.py
@@ -156,18 +156,44 @@ def match_previous_expr(expr: ParserElement) -> ParserElement:
     e2 = expr.copy()
     rep <<= e2
 
-    def copy_token_to_repeater(s, l, t):
-        match_tokens = _flatten(t.as_list())
+    # history of (loc, is_open, tokens) events for the string currently being
+    # parsed; events at or beyond a newly matched location are discarded, since
+    # they belong to parse paths that were backtracked over
+    events: list = []
+    current: list = [None]
+
+    def _record(s, l, is_open, tokens):
+        if current[0] is not s:
+            current[0] = s
+            events.clear()
+        while events and events[-1][0] >= l:
+            events.pop()
+        events.append((l, is_open, tokens))
+
+    def _expected_tokens(s, l):
+        if current[0] is not s:
+            return None
+        stack = []
+        for loc, is_open, tokens in events:
+            if loc >= l:
+                break
+            if is_open:
+                stack.append(tokens)
+            elif stack:
+                stack.pop()
+        return stack[-1] if stack else None
 
-        def must_match_these_tokens(s, l, t):
-            these_tokens = _flatten(t.as_list())
-            if these_tokens != match_tokens:
-                raise ParseException(
-                    s, l, f"Expected {match_tokens}, found{these_tokens}"
-                )
+    def copy_token_to_repeater(s, l, t):
+        _record(s, l, True, _flatten(t.as_list()))
 
-        e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    def must_match_these_tokens(s, l, t):
+        these_tokens = _flatten(t.as_list())
+        match_tokens = _expected_tokens(s, l)
+        if these_tokens != match_tokens:
+            raise ParseException(s, l, f"Expected {match_tokens}, found{these_tokens}")
+        _record(s, l, False, these_tokens)
 
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
     return rep
