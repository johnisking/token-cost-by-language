+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr with nested, repeated, and re-parsed matches"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        open_tag = pp.Suppress("{") + name + pp.Suppress("}")
+        close_tag = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        elem = pp.Forward()
+        elem <<= open_tag + pp.ZeroOrMore(elem | pp.Word("x")) + close_tag
+
+        for tst, expected in [
+            ("{a}xx{/a}", True),
+            ("{a}{b}xx{/b}{/a}", True),
+            ("{a}{b}xx{/a}{/b}", False),
+            ("{a}xx{/b}", False),
+            ("{a}xx{/a}", True),
+            ("{a}{b}x{/b}{c}x{/c}{/a}", True),
+        ]:
+            if expected:
+                elem.parse_string(tst, parse_all=True)
+            else:
+                with self.assertRaisesParseException(msg=f"expected fail: {tst!r}"):
+                    elem.parse_string(tst, parse_all=True)
+
+        word = pp.Word(pp.alphas)
+        pairs = pp.OneOrMore(pp.Group(word + ":" + pp.match_previous_expr(word)))
+        result = pairs.parse_string("a:a b:b", parse_all=True)
+        self.assertParseResultsEquals(
+            result, expected_list=[["a", ":", "a"], ["b", ":", "b"]]
+        )
+        with self.assertRaisesParseException():
+            pairs.parse_string("a:b", parse_all=True)
+        result = pairs.parse_string("c:c", parse_all=True)
+        self.assertParseResultsEquals(result, expected_list=[["c", ":", "c"]])
 
     def testRepeaterRecursiveFalse(self):
         """test match_previous_expr with recursive=False"""
