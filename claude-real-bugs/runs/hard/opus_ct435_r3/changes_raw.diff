+class ClassAccessTest(unittest.TestCase):
+    NAMES = (
+        "get",
+        "get_typed",
+        "get_info",
+        "get_lock",
+        "get_lock_info",
+        "get_cond",
+        "get_cond_info",
+        "get_lock_cond",
+        "get_lock_cond_info",
+    )
+
+    def test_class_access(self):
+        for name in self.NAMES:
+            with self.subTest(name=name):
+                cached = Cached(Cache(2))
+                method = getattr(Cached, name)
+                self.assertEqual(getattr(cached, name)(0), 0)
+                self.assertEqual(method(cached, 0), 0)
+                self.assertEqual(method(cached, 1), 1)
+                self.assertEqual(len(cached.cache), 2)
+                self.assertEqual(getattr(cached, name)(1), 1)
+                method.cache_clear(cached)
+                self.assertEqual(len(cached.cache), 0)
+                self.assertEqual(method(cached, 0), 2)
+
+    def test_class_access_info(self):
+        cached = Cached(Cache(2))
+        self.assertEqual(Cached.get_info(cached, 0), 0)
+        self.assertEqual(Cached.get_info(cached, 0), 0)
+        self.assertEqual(cached.get_info.cache_info(), (1, 1, 2, 1))
+
+    def test_class_access_wraps(self):
+        self.assertEqual(Cached.get.__doc__, "docstring")
+        self.assertEqual(Cached.get.__name__, "get")
+
+
