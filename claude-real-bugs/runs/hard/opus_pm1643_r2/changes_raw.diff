diff --git a/tests/test_syntax/blocks/test_html_blocks.py b/tests/test_syntax/blocks/test_html_blocks.py
index 1f2f877..7178cca 100644
--- a/tests/test_syntax/blocks/test_html_blocks.py
+++ b/tests/test_syntax/blocks/test_html_blocks.py
@@ -1015,6 +1015,65 @@ class TestHTMLBlocks(TestCase):
             )
         )
 
+    def test_comment_in_inline_raw_html(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture>
+                """
+            ),
+            self.dedent(
+                """
+                <p><picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture></p>
+                """
+            )
+        )
+
+    def test_comment_after_closed_inline_raw_html(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <span>foo</span>
+                <!-- comment -->
+                bar
+                """
+            ),
+            self.dedent(
+                """
+                <p><span>foo</span></p>
+                <!-- comment -->
+                <p>bar</p>
+                """
+            )
+        )
+
+    def test_comment_after_unclosed_inline_raw_html_and_blank_line(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <b>foo
+
+                <!-- comment -->
+                bar
+                """
+            ),
+            self.dedent(
+                """
+                <p><b>foo</p>
+                <!-- comment -->
+                <p>bar</p>
+                """
+            )
+        )
+
     # Note: This is a change in behavior. Previously, Python-Markdown interpreted this in the same manner
     # as browsers and all text after the opening comment tag was considered to be in a comment. However,
     # that did not match the reference implementation. The new behavior does.
