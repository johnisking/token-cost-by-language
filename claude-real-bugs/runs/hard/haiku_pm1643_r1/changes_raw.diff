+    def test_comment_in_inline_tag(self):
+        # A comment within an open inline tag is inline content, not a raw block.
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture>
+                """
+            ),
+            self.dedent(
+                """
+                <p><picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture></p>
+                """
+            )
+        )
+
+    def test_comment_after_inline_tag_blank_line(self):
+        # A blank line ends the paragraph, so a comment after it starts a new raw block.
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <span>Text
+
+                <!-- comment -->
+
+                Done
+                """
+            ),
+            self.dedent(
+                """
+                <p><span>Text</p>
+                <!-- comment -->
+
+                <p>Done</p>
+                """
+            )
+        )
+
