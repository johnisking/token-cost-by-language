   })
+
+  it('code span after unclosed link label', function () {
+    const md = markdownit('commonmark')
+    const def = markdownit()
+
+    // failed link/image label scan must not hide a later valid code span
+    assert.strictEqual(
+      md.render('[foo `bar` baz`'),
+      '<p>[foo <code>bar</code> baz`</p>\n'
+    )
+    assert.strictEqual(
+      md.render('![alt `code` x`'),
+      '<p>![alt <code>code</code> x`</p>\n'
+    )
+    assert.strictEqual(
+      md.render('[`a`b`'),
+      '<p>[<code>a</code>b`</p>\n'
+    )
+    assert.strictEqual(
+      def.render('[foo `bar` baz`'),
+      '<p>[foo <code>bar</code> baz`</p>\n'
+    )
+    assert.strictEqual(
+      def.render('![alt `code` x`'),
+      '<p>![alt <code>code</code> x`</p>\n'
+    )
+  })
