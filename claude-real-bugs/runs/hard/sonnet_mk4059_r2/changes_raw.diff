+   * another link is rejected, so only the inner links (and the trailing
+   * label) are masked and the text keeps its emphasis delimiters.
+   */
+  private maskReflinks(str: string): string {
+    const rules = this.tokenizer.rules.inline;
+    return str.replace(rules.reflinkSearch, match0 => {
+      if (!Object.hasOwn(this.tokens.links, match0.slice(match0.lastIndexOf('[') + 1, -1))) {
+        return match0;
+      }
+      const label = rules.reflink.exec(match0)?.[1];
+      if (label && label.includes('[')) {
+        const start = match0.indexOf('[') + 1;
+        const innerMasked = this.maskReflinks(label);
+        rules.blockSkip.lastIndex = 0;
+        if (innerMasked !== label || rules.blockSkip.test(label)) {
+          const tail = match0.length - start - label.length - 1;
+          return match0.slice(0, start) + innerMasked + ']' + '[' + 'a'.repeat(tail - 2) + ']';
+        }
+      }
+      return '[' + 'a'.repeat(match0.length - 2) + ']';
+    });
+  }
