+    def copy_token_to_repeater(s, l, t):
+        # discard stale entries from other strings or abandoned/backtracked parses
+        while pending and (pending[-1][0] is not s or pending[-1][1] >= l):
+            pending.pop()
+        pending.append((s, l, _flatten(t.as_list())))
+
+    def must_match_these_tokens(s, l, t):
+        these_tokens = _flatten(t.as_list())
+        match_tokens = None
+        for i in range(len(pending) - 1, -1, -1):
+            if pending[i][0] is s and pending[i][1] < l:
+                match_tokens = pending[i][2]
+                break
+        if match_tokens is None or these_tokens != match_tokens:
+            raise ParseException(
+                s, l, f"Expected {match_tokens}, found{these_tokens}"
+            )
+        del pending[i]
 
-        e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
 
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
