+    def testRepeaterMatchesRepeatedly(self):
+        """test match_previous_expr matches on every use, not just the first"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        open_tag = pp.Suppress("{") + name + pp.Suppress("}")
+        close_tag = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        pair = open_tag + pp.Literal("xx") + close_tag
+
+        # the same expression can match and repeat many times
+        for _ in range(3):
+            self.assertParseAndCheckList(pair, "{a}xx{/a}", ["a", "xx", "a"])
+            with self.assertRaisesParseException():
+                pair.parse_string("{a}xx{/b}")
+
+        # sequential pairs under OneOrMore
+        seq = pp.OneOrMore(pair)
+        self.assertParseAndCheckList(
+            seq, "{a}xx{/a}{b}xx{/b}", ["a", "xx", "a", "b", "xx", "b"]
+        )
+
+    def testRepeaterNestedMatches(self):
+        """test match_previous_expr with nested matches of the same expression"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        element = pp.Forward()
+        element <<= (
+            pp.Suppress("{")
+            + name
+            + pp.Suppress("}")
+            + pp.ZeroOrMore(element | pp.Literal("xx"))
+            + pp.Suppress("{/")
+            + pp.match_previous_expr(name)
+            + pp.Suppress("}")
+        )
+
+        self.assertParseAndCheckList(element, "{a}xx{/a}", ["a", "xx", "a"])
+        self.assertParseAndCheckList(
+            element, "{a}{b}xx{/b}{/a}", ["a", "b", "xx", "b", "a"]
+        )
+        with self.assertRaisesParseException():
+            element.parse_string("{a}{b}xx{/a}{/b}")
+
+        # a failed parse must not affect a later valid parse
+        with self.assertRaisesParseException():
+            element.parse_string("{a}xx{/b}")
+        self.assertParseAndCheckList(
+            element, "{c}{d}xx{/d}{/c}", ["c", "d", "xx", "d", "c"]
+        )
+
