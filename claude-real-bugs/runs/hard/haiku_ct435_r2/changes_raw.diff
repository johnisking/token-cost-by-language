+class ClassAccessTest(unittest.TestCase):
+    def test_explicit_instance(self):
+        class Example:
+            def __init__(self):
+                self.cache = Cache(2)
+                self.count = 0
+
+            @cachedmethod(lambda self: self.cache)
+            def value(self, number):
+                self.count += 1
+                return number * 2
+
+        example = Example()
+        self.assertEqual(example.value(3), 6)
+        self.assertEqual(Example.value(example, 3), 6)
+        self.assertEqual(example.count, 1)
+        self.assertEqual(Example.value(example, 4), 8)
+        self.assertEqual(example.value(4), 8)
+        self.assertEqual(example.count, 2)
