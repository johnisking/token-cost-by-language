+    def testRepeaterMatchesRepeatedAndNested(self):
+        """test match_previous_expr with repeated, nested, and retried matches"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        close = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        block = pp.Forward()
+        block <<= pp.Suppress("{") + name + pp.Suppress("}") + pp.ZeroOrMore(pp.Word("x") | block) + close
+        parser = block + pp.StringEnd()
+
+        tests = [
+            ("{a}xx{/a}", True),
+            ("{a}{b}xx{/b}{/a}", True),
+            ("{a}xx{/b}", False),
+            ("{a}{b}xx{/a}", False),
+        ]
+        for tst, expected in tests:
+            with self.subTest(tst=tst):
+                if expected:
+                    parser.parse_string(tst)
+                else:
+                    with self.assertRaises(pp.ParseException):
+                        parser.parse_string(tst)
+
+        # sequential matches under OneOrMore, each closed by its own word
+        word = pp.Word(pp.alphas)
+        seq = pp.OneOrMore(pp.Group(word + pp.Suppress(":") + pp.match_previous_expr(word)))
+        result = seq.parse_string("a:a b:b", parse_all=True)
+        self.assertEqual([["a", "a"], ["b", "b"]], [r.as_list() for r in result])
+
+        # a failed parse must not affect later parses of valid input
+        with self.assertRaises(pp.ParseException):
+            parser.parse_string("{a}xx{/b}")
+        self.assertEqual(
+            ["a", "xx", "a"],
+            parser.parse_string("{a}xx{/a}").as_list(),
+        )
+
