+    # stack of (location, tokens) for each match of expr that has not yet
+    # been matched by a repeat; nested matches push onto the stack, and each
+    # successful repeat pops the innermost one
+    open_matches = []
 
+    def copy_token_to_repeater(s, l, t):
+        # discard entries left behind by an earlier failed parse, which start
+        # at or after this match's location
+        while open_matches and open_matches[-1][0] >= l:
+            open_matches.pop()
+        open_matches.append((l, _flatten(t.as_list())))
+
+    def must_match_these_tokens(s, l, t):
+        these_tokens = _flatten(t.as_list())
+        if not open_matches or these_tokens != open_matches[-1][1]:
+            expected = open_matches[-1][1] if open_matches else []
+            raise ParseException(s, l, f"Expected {expected}, found {these_tokens}")
+
+    def pop_matched_token(s, l, t):
+        open_matches.pop()
+
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    rep.add_parse_action(pop_matched_token)
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
     return rep
