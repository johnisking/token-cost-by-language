+    def test_float_len_matches_iteration(self):
+        cases = [
+            (-8.732, -13.532, -2.4),
+            (-69.37276490678778, -29.8339073344664, 4.942357196540172),
+            (0.0, 1.0, 0.1),
+        ]
+        for args in cases:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                self.assertEqual(len(r), len(list(r)))
+
+    def test_float_items_are_members(self):
+        r = mi.numeric_range(0.0, 1.0, 0.1)
+        for i, item in enumerate(r):
+            with self.subTest(i=i):
+                self.assertIn(item, r)
+                self.assertEqual(r.index(item), i)
+                self.assertEqual(r.count(item), 1)
+        self.assertEqual(r[3], 0.30000000000000004)
+        self.assertEqual(sum(1 for v in r if v not in r), 0)
+
+    def test_float_indexable_items(self):
+        r = mi.numeric_range(
