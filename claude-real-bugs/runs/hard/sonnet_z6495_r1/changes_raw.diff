+test("default factory runs once inside object", () => {
+  let n = 0;
+  const schema = z.object({
+    a: z.string().default(() => {
+      n++;
+      return "d";
+    }),
+  });
+  expect(schema.parse({})).toEqual({ a: "d" });
+  expect(n).toBe(1);
+});
+
