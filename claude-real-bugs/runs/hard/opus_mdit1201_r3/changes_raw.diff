diff --git a/src/rules_inline/backticks.ts b/src/rules_inline/backticks.ts
index 9fd05dc..a1ee2bb 100644
--- a/src/rules_inline/backticks.ts
+++ b/src/rules_inline/backticks.ts
@@ -37,7 +37,9 @@ export default function backtick (state: StateInline, silent: boolean): boolean
     const closerLength = matchEnd - matchStart
 
     if (closerLength === openerLength) {
-      // Found matching closer length.
+      // Found matching closer length. Remember it, so that a later cache
+      // lookup (e.g. after a lookahead from a link label) doesn't miss it.
+      state.backticks[closerLength] = Math.max(state.backticks[closerLength] || 0, matchStart)
       if (!silent) {
         const token = state.push('code_inline', 'code', 0)
         token.markup = marker
@@ -50,12 +52,16 @@ export default function backtick (state: StateInline, silent: boolean): boolean
     }
 
     // Some different length found, put it in cache as upper limit of where closer can be found
-    state.backticks[closerLength] = matchStart
+    state.backticks[closerLength] = Math.max(state.backticks[closerLength] || 0, matchStart)
   }
 
   // Scanned through the end, didn't find anything
   state.backticksScanned = true
 
+  // This opener may still serve as a closer for an earlier opener
+  // (visited out of order by lookahead), so record its position too.
+  state.backticks[openerLength] = Math.max(state.backticks[openerLength] || 0, start)
+
   if (!silent) state.pending += marker
   state.pos += openerLength
   return true
