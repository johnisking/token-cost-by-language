+    def __init_subclass__(cls, **kwargs):
+        super().__init_subclass__(**kwargs)
+        call = cls.__dict__.get("__call__")
+        if call is None:
+            return
+
+        @functools.wraps(call)
+        def __call__(self, *args, **kwargs):
+            if self._obj is None and self._descriptor is not None:
+                # accessed through the class: first argument is the instance
+                if not args:
+                    raise TypeError(
+                        "missing instance argument for unbound @cachedmethod"
+                    )
+                obj, *args = args
+                return self._descriptor.__get__(obj, type(obj))(*args, **kwargs)
+            return call(self, *args, **kwargs)
+
+        cls.__call__ = __call__
