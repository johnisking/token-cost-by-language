+class ClassAccessTest(unittest.TestCase):
+    def test_class_access_with_instance(self):
+        for name in (
+            "get",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        ):
+            with self.subTest(name=name):
+                cached = Cached(Cache(10))
+                method = getattr(Cached, name)
+                self.assertEqual(getattr(cached, name)(1), 0)
+                self.assertEqual(method(cached, 1), 0)
+                self.assertEqual(method(cached, value=2), 1)
+                self.assertEqual(getattr(cached, name)(value=2), 1)
+                self.assertEqual(len(cached.cache), 2)
+                self.assertEqual(method.__name__, name)
+
