+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr with nested, sequential, and repeated parses"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        open_tag = pp.Suppress("{") + name + pp.Suppress("}")
+        close_tag = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        elem = pp.Forward()
+        elem <<= pp.Group(open_tag + pp.ZeroOrMore(elem | pp.Word("x")) + close_tag)
+
+        tests = [
+            ("{a}xx{/a}", [["a", "xx", "a"]]),
+            ("{a}{b}xx{/b}{/a}", [["a", ["b", "xx", "b"], "a"]]),
+            ("{a}{a}xx{/a}{/a}", [["a", ["a", "xx", "a"], "a"]]),
+            ("{a}{b}x{/b}{c}x{/c}{/a}", [["a", ["b", "x", "b"], ["c", "x", "c"], "a"]]),
+            ("{a}{b}xx{/a}{/b}", None),
+            ("{a}xx{/b}", None),
+            ("{a}xx{/a}", [["a", "xx", "a"]]),
+        ]
+        for tst, expected in tests:
+            if expected is not None:
+                self.assertEqual(
+                    expected, elem.parse_string(tst, parse_all=True).as_list()
+                )
+            else:
+                with self.assertRaisesParseException(msg=f"expected fail: {tst!r}"):
+                    elem.parse_string(tst, parse_all=True)
+
+        first = pp.Word(pp.alphas)
+        seq = pp.OneOrMore(pp.Group(first + ":" + pp.match_previous_expr(first)))
+        self.assertParseAndCheckList(
+            seq, "a:a b:b", [["a", ":", "a"], ["b", ":", "b"]]
+        )
+        with self.assertRaisesParseException():
+            seq.parse_string("a:b", parse_all=True)
+        self.assertParseAndCheckList(
+            seq, "a:a b:b", [["a", ":", "a"], ["b", ":", "b"]]
+        )
+
