-                raise ParseException(
-                    s, l, f"Expected {match_tokens}, found{these_tokens}"
-                )
+    # Matches of expr are tracked by location, so that nested and repeated
+    # pairs can be matched up like brackets, and so that state left behind by
+    # backtracking or by a previous parse is discarded:
+    # - opens: list of (loc, tokens) for each match of expr, in loc order
+    # - closes: dict mapping loc of each repeat match -> loc of its open
+    state: dict = {"s": None, "opens": [], "closes": {}}
+
+    def _sync_state(s, l):
+        if state["s"] is not s and state["s"] != s:
+            state["s"] = s
+            state["opens"] = []
+            state["closes"] = {}
+            return
+        # anything recorded at or after l came from a parse path that has
+        # since been abandoned (backtracking or reparsing)
+        state["opens"] = [o for o in state["opens"] if o[0] < l]
+        state["closes"] = {
+            cl: ol for cl, ol in state["closes"].items() if cl < l
+        }
 
-        e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    def copy_token_to_repeater(s, l, t):
+        _sync_state(s, l)
+        state["opens"].append((l, _flatten(t.as_list())))
+
+    def must_match_these_tokens(s, l, t):
+        these_tokens = _flatten(t.as_list())
+        _sync_state(s, l)
+        opens = state["opens"]
+        if not opens:
+            raise ParseException(s, l, f"Expected {expr}, found{these_tokens}")
+
+        # find the innermost open match not yet closed; if all have been
+        # closed, fall back to the most recent one
+        closed = set(state["closes"].values())
+        open_loc, match_tokens = next(
+            (o for o in reversed(opens) if o[0] not in closed), opens[-1]
+        )
+        if these_tokens != match_tokens:
+            raise ParseException(
+                s, l, f"Expected {match_tokens}, found{these_tokens}"
+            )
+        state["closes"][l] = open_loc
 
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
     return rep
