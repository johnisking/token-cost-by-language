-        match_tokens = _flatten(t.as_list())
+    # tokens of the matches of expr not yet matched by a repeat, innermost last;
+    # each repeat consumes the most recent entry, so nested matches work and
+    # later matches (or matches made before a failed parse) are not compared
+    # against stale tokens
+    open_matches = []
 
-        def must_match_these_tokens(s, l, t):
-            these_tokens = _flatten(t.as_list())
-            if these_tokens != match_tokens:
-                raise ParseException(
-                    s, l, f"Expected {match_tokens}, found{these_tokens}"
-                )
+    def copy_token_to_repeater(s, l, t):
+        open_matches.append(_flatten(t.as_list()))
 
-        e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    def must_match_these_tokens(s, l, t):
+        if not open_matches:
+            return
+        these_tokens = _flatten(t.as_list())
+        if these_tokens != open_matches[-1]:
+            raise ParseException(
+                s, l, f"Expected {open_matches[-1]}, found {these_tokens}"
+            )
+        open_matches.pop()
 
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
     return rep
