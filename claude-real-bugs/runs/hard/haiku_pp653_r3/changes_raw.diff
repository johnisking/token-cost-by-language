+    def testRepeaterRepeatedMatches(self):
+        """test match_previous_expr over repeated, nested, and retried matches"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        opening = pp.Suppress("{") + name + pp.Suppress("}")
+        closing = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        simple = opening + pp.Suppress("xx") + closing
+        nested = opening + opening + pp.Suppress("xx") + closing + closing
+        pair = name + pp.Suppress(":") + pp.match_previous_expr(name)
+        pairs = pp.OneOrMore(pair)
+
+        with self.subTest("simple"):
+            self.assertParseAndCheckList(simple, "{a}xx{/a}", ["a", "a"])
+            with self.assertRaisesParseException():
+                simple.parse_string("{a}xx{/b}")
+
+        with self.subTest("nested"):
+            self.assertParseAndCheckList(nested, "{a}{b}xx{/b}{/a}", ["a", "b", "b", "a"])
+            with self.assertRaisesParseException():
+                nested.parse_string("{a}{b}xx{/a}{/b}")
+
+        with self.subTest("sequential pairs"):
+            self.assertParseAndCheckList(pairs, "a:a b:b", ["a", "a", "b", "b"])
+            with self.assertRaisesParseException():
+                pairs.parse_string("a:a b:c", parse_all=True)
+
+        with self.subTest("reparse after failure"):
+            with self.assertRaisesParseException():
+                simple.parse_string("{a}xx{/b}")
+            self.assertParseAndCheckList(simple, "{a}xx{/a}", ["a", "a"])
+            with self.assertRaisesParseException():
+                pairs.parse_string("a:b")
+            self.assertParseAndCheckList(pairs, "a:a b:b", ["a", "a", "b", "b"])
+
