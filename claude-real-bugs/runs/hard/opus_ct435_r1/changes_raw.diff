+class ClassAccessTest(unittest.TestCase):
+    def test_class_access(self):
+        cached = Cached(Cache(maxsize=10))
+
+        self.assertEqual(Cached.get(cached, 0), 0)
+        self.assertEqual(cached.get(0), 0)
+        self.assertEqual(Cached.get(cached, 1), 1)
+        self.assertEqual(len(cached.cache), 2)
+
+        self.assertEqual(Cached.get_info(cached, 2), 2)
+        self.assertEqual(Cached.get_info(cached, 2), 2)
+        self.assertEqual(cached.get_info.cache_info().hits, 1)
+
+        self.assertEqual(Cached.get_lock(cached, 3), 3)
+        self.assertEqual(Cached.get_cond(cached, 4), 4)
+        self.assertEqual(cached.count, 5)
