+// object keys are strings at runtime, so numeric key schemas describe their string form
+const stringifyKeySchema = (keyJson: JSONSchema.BaseSchema): JSONSchema.BaseSchema => {
+  if (keyJson.enum?.some((v) => typeof v === "number")) {
+    return { ...keyJson, type: "string", enum: keyJson.enum.map(String) };
+  }
+  if (typeof keyJson.const === "number") return { ...keyJson, type: "string", const: String(keyJson.const) };
+  if (keyJson.type === "integer") return { type: "string", pattern: "^-?\\d+$" };
+  if (keyJson.type === "number") return { type: "string", pattern: "^-?\\d+(\\.\\d+)?$" };
+  return keyJson;
+};
