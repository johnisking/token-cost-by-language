+class ClassAccessTest(unittest.TestCase):
+    def test_class_call_with_instance(self):
+        class Example:
+            def __init__(self):
+                self.cache = Cache(2)
+
+            @cachedmethod(lambda self: self.cache)
+            def value(self, number):
+                return number * 2
+
+        example = Example()
+        self.assertEqual(example.value(3), 6)
+        self.assertEqual(Example.value(example, 3), 6)  # type: ignore
+        # the explicitly supplied instance's cache is used
+        self.assertEqual(example.cache.currsize, 1)
+        self.assertEqual(Example.value(example, 4), 8)  # type: ignore
+        self.assertEqual(example.cache.currsize, 2)
