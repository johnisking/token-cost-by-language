+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr with nested, sequential, and repeated parses"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        open_tag = "{" + name + "}"
+        close_tag = "{/" + pp.match_previous_expr(name) + "}"
+        tag = pp.Forward()
+        tag <<= open_tag + (tag | "xx") + close_tag
+
+        tests = [
+            ("{a}xx{/a}", True),
+            ("{a}{b}xx{/b}{/a}", True),
+            ("{a}{b}xx{/a}{/b}", False),
+            ("{a}xx{/b}", False),
+            ("{a}xx{/a}", True),
+            ("{a}{b}{c}xx{/c}{/b}{/a}", True),
+        ]
+        for tst, expected in tests:
+            if expected:
+                tag.parse_string(tst, parse_all=True)
+            else:
+                with self.assertRaisesParseException(msg=tst):
+                    tag.parse_string(tst, parse_all=True)
+
+        self.assertParseAndCheckList(
+            pp.OneOrMore(tag),
+            "{a}xx{/a}{b}xx{/b}",
+            ["{", "a", "}", "xx", "{/", "a", "}", "{", "b", "}", "xx", "{/", "b", "}"],
+        )
+
+        word = pp.Word(pp.alphas)
+        pair = word + ":" + pp.match_previous_expr(word)
+        self.assertParseAndCheckList(
+            pp.OneOrMore(pair), "a:a b:b", ["a", ":", "a", "b", ":", "b"]
+        )
+        with self.assertRaisesParseException():
+            pair.parse_string("a:b", parse_all=True)
+        self.assertParseAndCheckList(pair, "c:c", ["c", ":", "c"])
+
