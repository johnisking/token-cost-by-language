+// json object keys are always strings, so numeric key schemas become the numeric strings a record coerces from
+function stringifyNumericKeys(json: JSONSchema.BaseSchema): JSONSchema.BaseSchema {
+  const toStr = <T>(v: T) => (typeof v === "number" ? String(v) : v);
+  const numeric = json.type === "number" || json.type === "integer";
+  let out = json;
+  if (numeric || json.enum?.some((v) => typeof v === "number") || typeof json.const === "number") {
+    out = { ...json };
+    if (out.enum) out.enum = out.enum.map(toStr);
+    if (out.const !== undefined) out.const = toStr(out.const);
+    if (numeric) {
+      delete out.minimum;
+      delete out.maximum;
+      delete out.exclusiveMinimum;
+      delete out.exclusiveMaximum;
+      delete out.multipleOf;
+      if (!out.enum && out.const === undefined) out.pattern = (json.type === "integer" ? integer : number).source;
+      out.type = "string";
+    }
+  }
+  for (const key of ["anyOf", "oneOf", "allOf"] as const) {
+    const list = out[key];
+    if (!list) continue;
+    const mapped = list.map(stringifyNumericKeys) as JSONSchema.JSONSchema[];
+    if (mapped.some((s, i) => s !== list[i])) {
+      if (out === json) out = { ...json };
+      out[key] = mapped;
+    }
+  }
+  return out;
+}
