+  // Whether reflink() will reject the reference link at the start of src because its text holds another link.
+  // Lexes the text the same way outputLink does, so the masking pass can leave a rejected link's emphasis visible.
+  reflinkTextHasLink(src: string): boolean {
+    const cap = this.rules.inline.reflink.exec(src) || this.rules.inline.nolink.exec(src);
