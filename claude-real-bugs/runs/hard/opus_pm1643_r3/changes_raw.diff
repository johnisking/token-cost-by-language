+        self.inline_stack.append((tag, self.line_offset + self.offset))
+
+    def close_inline_tag(self, tag: str) -> None:
+        """ Record the end of an inline (span level) raw HTML tag and any unclosed tags nested within it. """
+        for i in range(len(self.inline_stack) - 1, -1, -1):
+            if self.inline_stack[i][0] == tag:
+                del self.inline_stack[i:]
+                break
+
+    def in_inline_html(self) -> bool:
+        """
