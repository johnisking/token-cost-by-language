+class ClassAccessTest(unittest.TestCase):
+    def test_class_call_with_instance(self):
+        class Example:
+            def __init__(self):
+                self.cache = Cache(2)
+
+            @cachedmethod(lambda self: self.cache)
+            def value(self, number):
+                return number * 2
+
+        example = Example()
+        self.assertEqual(6, example.value(3))
+        self.assertEqual(6, Example.value(example, 3))
+        self.assertEqual(1, len(example.cache))
+        with self.assertRaises(TypeError):
+            Example.value()
+
+
