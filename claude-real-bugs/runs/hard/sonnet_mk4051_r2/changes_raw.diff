+function containsLink(tokens: Token[]): boolean {
+  return tokens.some(t => t.type === 'link' || (!!t.tokens && containsLink(t.tokens)));
+}
+
+function outputLink(cap: string[], link: Pick<Tokens.Link, 'href' | 'title'>, raw: string, lexer: _Lexer, rules: Rules): Tokens.Link | Tokens.Image | Tokens.Text {
