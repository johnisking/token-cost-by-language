@@ -1,6 +1,16 @@
 import { expect, expectTypeOf, test } from "vitest";
 import { z } from "zod/v4";
 
+test("default factory runs once per object parse", () => {
+  let n = 0;
+  const schema = z.object({
+    a: z.string().default(() => `${n++}`),
+    b: z.string().prefault(() => `${n++}`),
+  });
+  expect(schema.parse({})).toEqual({ a: "0", b: "1" });
+  expect(n).toBe(2);
+});
+
 test("basic defaults", () => {
   expect(z.string().default("default").parse(undefined)).toBe("default");
 });
