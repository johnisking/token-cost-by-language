+// json property names are always strings, so numeric keys become their string form
+function numericPropertyNames(keyJson: JSONSchema.BaseSchema, keyType: schemas.$ZodType): JSONSchema.StringSchema {
+  if (Array.isArray(keyJson.enum)) return { type: "string", enum: keyJson.enum.map(String) };
+  if (keyJson.const !== undefined) return { type: "string", const: String(keyJson.const) };
+  const pattern = keyType._zod.pattern;
+  return pattern ? { type: "string", pattern: pattern.source } : { type: "string" };
+}
