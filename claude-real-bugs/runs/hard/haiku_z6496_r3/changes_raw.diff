+// json keys are strings, so numeric key schemas match their numeric-string form
+const toStringKeySchema = (key: JSONSchema.BaseSchema): JSONSchema.BaseSchema => {
+  const numeric = key.type === "number" || key.type === "integer";
+  if (key.enum) {
+    return {
+      ...key,
+      ...(numeric && { type: "string" }),
+      enum: key.enum.map((v) => (typeof v === "number" ? String(v) : v)),
+    } as JSONSchema.BaseSchema;
+  }
+  if (typeof key.const === "number") return { type: "string", const: String(key.const) };
+  if (key.type === "integer") return { type: "string", pattern: "^-?\\d+$" };
+  if (key.type === "number") return { type: "string", pattern: "^-?\\d+(?:\\.\\d+)?$" };
+  return key;
+};
