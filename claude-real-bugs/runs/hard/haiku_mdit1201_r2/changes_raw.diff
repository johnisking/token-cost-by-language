diff --git a/src/rules_inline/backticks.ts b/src/rules_inline/backticks.ts
index 9fd05dc..29d771a 100644
--- a/src/rules_inline/backticks.ts
+++ b/src/rules_inline/backticks.ts
@@ -18,7 +18,9 @@ export default function backtick (state: StateInline, silent: boolean): boolean
   const marker = state.src.slice(start, pos)
   const openerLength = marker.length
 
-  if (state.backticksScanned && (state.backticks[openerLength] || 0) <= start) {
+  // Cache only knows about backticks after the position its scan started from,
+  // so it can't be used for openers before that (e.g. after a failed link label parse)
+  if (state.backticksScanned && start >= state.backticksScanStart && (state.backticks[openerLength] || 0) <= start) {
     if (!silent) state.pending += marker
     state.pos += openerLength
     return true
@@ -55,6 +57,7 @@ export default function backtick (state: StateInline, silent: boolean): boolean
 
   // Scanned through the end, didn't find anything
   state.backticksScanned = true
+  state.backticksScanStart = Math.min(state.backticksScanStart, start)
 
   if (!silent) state.pending += marker
   state.pos += openerLength
