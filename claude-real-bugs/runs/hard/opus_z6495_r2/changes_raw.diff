--- a/packages/zod/src/v4/classic/tests/default.test.ts
+++ b/packages/zod/src/v4/classic/tests/default.test.ts
@@ -1,6 +1,19 @@
 import { expect, expectTypeOf, test } from "vitest";
 import { z } from "zod/v4";
 
+test("default function runs once per parse inside an object", () => {
+  let calls = 0;
+  const fn = () => {
+    calls++;
+    return "d";
+  };
+  const schema = z.object({ a: z.string().default(fn), b: z.string().prefault(fn) });
+  expect(schema.parse({})).toEqual({ a: "d", b: "d" });
+  expect(calls).toBe(2);
+  expect(schema.parse({})).toEqual({ a: "d", b: "d" });
+  expect(calls).toBe(4);
+});
+
 test("basic defaults", () => {
   expect(z.string().default("default").parse(undefined)).toBe("default");
 });
