diff --git a/lib/utils.js b/lib/utils.js
index b86b94f..441530b 100644
--- a/lib/utils.js
+++ b/lib/utils.js
@@ -404,8 +404,15 @@ var encode = function encode(str, defaultEncoder, charset, kind, format) {
                 continue;
             }
 
+            var next = segment.charCodeAt(i + 1);
+            if (c > 0xDBFF || !(next >= 0xDC00 && next <= 0xDFFF)) {
+                // lone surrogate: encode U+FFFD like URLSearchParams and TextEncoder do, and keep the next character
+                arr[arr.length] = '%EF%BF%BD';
+                continue;
+            }
+
             i += 1;
-            c = 0x10000 + (((c & 0x3FF) << 10) | (segment.charCodeAt(i) & 0x3FF));
+            c = 0x10000 + (((c & 0x3FF) << 10) | (next & 0x3FF));
 
             arr[arr.length] = hexTable[0xF0 | (c >> 18)]
                 + hexTable[0x80 | ((c >> 12) & 0x3F)]
