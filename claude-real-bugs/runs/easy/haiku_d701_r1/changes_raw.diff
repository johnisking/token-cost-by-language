+/**
+ * Returns true if the line ends with a CR which is a line-ending CR (rather than literal content).
+ * A line followed by a "\ No newline at end of file" marker has no line ending at all, so any
+ * trailing CR in such a line is part of its content.
+ */
+function hasCRLineEnding(line: string, nextLine: string | undefined): boolean {
+  return line.endsWith('\r') && !line.startsWith('\\') && !nextLine?.startsWith('\\');
