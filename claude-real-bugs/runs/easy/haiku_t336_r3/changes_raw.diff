diff --git a/tests/test_api.py b/tests/test_api.py
index b5f31bc..9b55e33 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -224,6 +224,26 @@ def test_integer() -> None:
     assert isinstance(i, Integer)
 
 
+def test_integer_keeps_underscores() -> None:
+    i = tomlkit.integer("1_000")
+
+    assert isinstance(i, Integer)
+    assert i == 1000
+    assert int(i) == 1000
+    assert i.as_string() == "1_000"
+
+    doc = tomlkit.document()
+    doc["n"] = tomlkit.integer("53_49_221")
+    assert tomlkit.dumps(doc) == "n = 53_49_221\n"
+    assert tomlkit.parse(tomlkit.dumps(doc))["n"] == 5349221
+
+
+def test_integer_plain_string_unchanged() -> None:
+    assert tomlkit.integer("34").as_string() == "34"
+    assert tomlkit.integer(" 42 ").as_string() == "42"
+    assert tomlkit.integer(7).as_string() == "7"
+
+
 def test_float() -> None:
     i = tomlkit.float_("34.56")
 
