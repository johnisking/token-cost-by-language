     assert parse(doc.as_string())["a"] == a
 
 
+@pytest.mark.parametrize(
+    "index, expected",
+    [
+        (slice(None, 0), "[1, 2, 3]"),
+        (slice(-1, None), "[1, 2]"),
+        (slice(None, -1), "[3]"),
+        (slice(1, None), "[1]"),
+        (slice(None, None, -2), "[2]"),
+        (slice(None, None), "[]"),
+    ],
+)
+def test_array_slice_deletion(index: slice, expected: str) -> None:
+    doc = parse("a = [1, 2, 3]\n")
+    a = doc["a"]
+    py_list = [1, 2, 3]
+    del a[index]
+    del py_list[index]
+
+    assert a == py_list
+    assert a.as_string() == expected
+    assert parse(doc.as_string())["a"] == py_list
+
+
 def test_array_behaves_like_a_list() -> None:
     a = item([1, 2])
 
