     }
 
+    if (parsed.hostname && parsed.hostname.indexOf(':') !== -1) {
+      // IPv6 literal: brackets around the host must stay unencoded,
+      // so encode parts before and after the host separately
+      const before = mdurl.format({ ...parsed, hostname: null, port: null, pathname: null, search: null, hash: null })
+      const after = mdurl.format({ ...parsed, protocol: null, slashes: false, auth: null, hostname: null })
+      return mdurl.encode(before) + '[' + mdurl.encode(parsed.hostname) + ']' + mdurl.encode(after)
+    }
+
     return mdurl.encode(mdurl.format(parsed))
   }
 
