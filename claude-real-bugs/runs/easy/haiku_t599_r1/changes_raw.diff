     assert parse(doc.as_string())["a"] == a
 
 
+@pytest.mark.parametrize(
+    "index",
+    [
+        slice(None, 0),
+        slice(-1, None),
+        slice(None, -1),
+        slice(1, None),
+        slice(None, None, 2),
+    ],
+)
+def test_array_slice_delete_matches_list(index: slice) -> None:
+    doc = parse("a = [1, 2, 3]\n")
+    expected = [1, 2, 3]
+    del expected[index]
+
+    del doc["a"][index]
+
+    assert doc["a"] == expected
+    assert doc["a"].as_string() == "[" + ", ".join(str(x) for x in expected) + "]"
+    assert parse(doc.as_string())["a"] == expected
+
+
 def test_array_behaves_like_a_list() -> None:
