diff --git a/src/ast/styler_defaults.ts b/src/ast/styler_defaults.ts
index d61ce64..446cd58 100644
--- a/src/ast/styler_defaults.ts
+++ b/src/ast/styler_defaults.ts
@@ -61,8 +61,11 @@ function doubleQuoteWhitespaceOnly (layout: ScalarLayout): void {
 function applyForceQuotesOption (layout: ScalarLayout): void {
   if (!layout.presenterOptions.forceQuotes) return
 
-  // forceQuotes applies only to plain values, not to mapping keys.
+  // forceQuotes applies only to plain string values, not to mapping keys or
+  // to non-string scalars (booleans, numbers, null, ...), which would otherwise
+  // need explicit tags to keep their types.
   if (layout.isKey || layout.style !== SCALAR_STYLE.PLAIN) return
+  if (layout.node.tag !== layout.presenterOptions.schema.defaultScalarTag.tagName) return
 
   layout.style = layout.node.value.includes('\n')
     ? SCALAR_STYLE.DOUBLE_QUOTED
