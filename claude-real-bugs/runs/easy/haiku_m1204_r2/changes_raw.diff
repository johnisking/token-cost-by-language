diff --git a/src/markdownit.ts b/src/markdownit.ts
index 4dc2ce9..63c2f48 100644
--- a/src/markdownit.ts
+++ b/src/markdownit.ts
@@ -162,7 +162,22 @@ class MarkdownIt {
       }
     }
 
-    return mdurl.encode(mdurl.format(parsed))
+    const formatted = mdurl.format(parsed)
+
+    // IPv6 hosts must keep their literal brackets (`[...]`), otherwise the
+    // URL is invalid per WHATWG URL Standard. Encode the rest around them.
+    if (parsed.hostname && parsed.hostname.indexOf(':') !== -1) {
+      const host = '[' + parsed.hostname + ']'
+      const start = formatted.indexOf(host)
+
+      if (start !== -1) {
+        return mdurl.encode(formatted.slice(0, start)) +
+          host +
+          mdurl.encode(formatted.slice(start + host.length))
+      }
+    }
+
+    return mdurl.encode(formatted)
   }
 
