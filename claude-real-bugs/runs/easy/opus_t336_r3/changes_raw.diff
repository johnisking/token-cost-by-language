diff --git a/tests/test_api.py b/tests/test_api.py
index b5f31bc..cdf17d5 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -224,6 +224,22 @@ def test_integer() -> None:
     assert isinstance(i, Integer)
 
 
+@pytest.mark.parametrize(
+    "raw, value",
+    [("1_000", 1000), ("5_349_221", 5349221), ("1_2_3_4_5", 12345), ("+1_000", 1000), ("-1_0", -10)],
+)
+def test_integer_preserves_underscores(raw: str, value: int) -> None:
+    i = tomlkit.integer(raw)
+
+    assert i.as_string() == raw
+    assert int(i) == value
+
+    doc = tomlkit.document()
+    doc["n"] = i
+    assert tomlkit.dumps(doc) == f"n = {raw}\n"
+    assert tomlkit.parse(tomlkit.dumps(doc))["n"] == value
+
+
 def test_float() -> None:
     i = tomlkit.float_("34.56")
 
