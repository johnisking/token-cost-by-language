diff --git a/lib/utils.js b/lib/utils.js
index b86b94f..01d3514 100644
--- a/lib/utils.js
+++ b/lib/utils.js
@@ -404,8 +404,16 @@ var encode = function encode(str, defaultEncoder, charset, kind, format) {
                 continue;
             }
 
+            // a lone surrogate (a low one, or a high one not followed by a low one) is encoded as U+FFFD,
+            // without consuming the next character, as URLSearchParams and TextEncoder do
+            var next = i + 1 < segment.length ? segment.charCodeAt(i + 1) : 0;
+            if (c >= 0xDC00 || next < 0xDC00 || next > 0xDFFF) {
+                arr[arr.length] = '%EF%BF%BD';
+                continue;
+            }
+
             i += 1;
-            c = 0x10000 + (((c & 0x3FF) << 10) | (segment.charCodeAt(i) & 0x3FF));
+            c = 0x10000 + (((c & 0x3FF) << 10) | (next & 0x3FF));
 
             arr[arr.length] = hexTable[0xF0 | (c >> 18)]
                 + hexTable[0x80 | ((c >> 12) & 0x3F)]
