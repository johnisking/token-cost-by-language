diff --git a/tests/test_api.py b/tests/test_api.py
index b5f31bc..ddc6349 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -224,6 +224,27 @@ def test_integer() -> None:
     assert isinstance(i, Integer)
 
 
+@pytest.mark.parametrize("raw", ["1_000", "5_349_221", "53_49_221", "1_2_3_4_5", "-1_000"])
+def test_integer_keeps_underscores(raw: str) -> None:
+    i = tomlkit.integer(raw)
+
+    assert isinstance(i, Integer)
+    assert i.as_string() == raw
+    assert int(i) == int(raw)
+
+    doc = tomlkit.document()
+    doc["n"] = i
+    assert tomlkit.dumps(doc) == f"n = {raw}\n"
+    assert tomlkit.parse(tomlkit.dumps(doc))["n"] == int(raw)
+
+
+def test_integer_with_underscores_keeps_sign_on_arithmetic() -> None:
+    i = tomlkit.integer("+1_000")
+
+    assert i.as_string() == "+1_000"
+    assert (i + 1).as_string() == "+1001"
+
+
 def test_float() -> None:
     i = tomlkit.float_("34.56")
 
