@@ -115,7 +116,15 @@ def document() -> TOMLDocument:
 
 # Items
 def integer(raw: str | int) -> Integer:
-    """Create an integer item from a number or string."""
+    """Create an integer item from a number or string.
+
+    A string using underscores between digits (e.g. ``"1_000"``) keeps its
+    formatting when rendered.
+    """
+    if isinstance(raw, str):
+        stripped = raw.strip()
+        if "_" in stripped and re.fullmatch(r"[+\-]?(0|[1-9](_?\d)*)", stripped):
+            return Integer(int(stripped), Trivia(), stripped)
     return item(int(raw))
 
 
