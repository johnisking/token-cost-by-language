+      // IPv6 address literal, brackets around it must stay unencoded,
+      // e.g. `http://[2001:db8::1]/`
+      const head = mdurl.format({ ...parsed, hostname: null, port: null, pathname: null, search: null, hash: null })
+      const tail = mdurl.format({ ...parsed, protocol: null, slashes: null, auth: null, hostname: null })
