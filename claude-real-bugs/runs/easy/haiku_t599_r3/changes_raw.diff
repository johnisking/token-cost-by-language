@@ -1202,6 +1202,26 @@ def test_inline_table_render_after_edits() -> None:
     assert edited("t = {a = 1, b = 2, c = 3}", "b", "c") == "t = {a = 1  }"
 
 
+@pytest.mark.parametrize(
+    ("index", "expected"),
+    [
+        (slice(None, 0), [1, 2, 3]),
+        (slice(-1, None), [1, 2]),
+        (slice(None, -1), [3]),
+        (slice(None, None, 2), [2]),
+        (slice(1, None), [1]),
+        (slice(None, None, -1), []),
+    ],
+)
+def test_array_del_slice_keeps_rendering_in_sync(index: slice, expected: list) -> None:
+    doc = parse("a = [1, 2, 3]\n")
+    arr = doc["a"]
+    del arr[index]
+    assert list(arr) == expected
+    assert arr.as_string() == "[" + ", ".join(str(v) for v in expected) + "]"
+    assert doc.as_string() == f"a = {arr.as_string()}\n"
+
+
