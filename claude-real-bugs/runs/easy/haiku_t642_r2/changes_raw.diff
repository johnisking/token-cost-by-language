@@ -246,3 +246,19 @@ def test_parser_accepts_uppercase_exponent_after_leading_zero() -> None:
         value = Parser(f"a = {raw}").parse()["a"]
         assert isinstance(value, Float)
         assert value == float(raw)
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "a = 1\r\nb = 2\r\nc = @\r\nd = 4\r\n",
+        "a = 1\nb = 2\nc = @\nd = 4\n",
+        "a = 1\r\nb = 2\nc = @\r\nd = 4\n",
+    ],
+)
+def test_parser_error_position_is_independent_of_line_endings(content: str) -> None:
+    with pytest.raises(UnexpectedCharError) as e:
+        Parser(content).parse()
+
+    assert e.value.line == 3
+    assert e.value.col == 4
