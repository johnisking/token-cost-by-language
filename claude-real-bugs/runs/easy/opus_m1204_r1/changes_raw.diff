diff --git a/src/markdownit.ts b/src/markdownit.ts
index 4dc2ce9..5940c88 100644
--- a/src/markdownit.ts
+++ b/src/markdownit.ts
@@ -162,6 +162,15 @@ class MarkdownIt {
       }
     }
 
+    if (parsed.hostname && parsed.hostname.indexOf(':') !== -1) {
+      // IPv6 host literal: brackets must stay unencoded (WHATWG URL requires
+      // `[` and `]` around IPv6 hosts), so encode parts around them separately.
+      const before = mdurl.format({ ...parsed, hostname: '', port: null, pathname: null, search: null, hash: null })
+      const after = mdurl.format({ ...parsed, protocol: null, slashes: false, auth: null, hostname: '' })
+
+      return mdurl.encode(before) + '[' + mdurl.encode(parsed.hostname) + ']' + mdurl.encode(after)
+    }
+
     return mdurl.encode(mdurl.format(parsed))
   }
 
