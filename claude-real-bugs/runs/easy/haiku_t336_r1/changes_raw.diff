@@ -224,6 +224,18 @@ def test_integer() -> None:
     assert isinstance(i, Integer)
 
 
+def test_integer_preserves_underscores() -> None:
+    i = tomlkit.integer("1_000")
+
+    assert i.as_string() == "1_000"
+    assert int(i) == 1000
+
+    doc = tomlkit.document()
+    doc["n"] = tomlkit.integer("53_49_221")
+
+    assert tomlkit.dumps(doc) == "n = 53_49_221\n"
+
+
 def test_float() -> None:
     i = tomlkit.float_("34.56")
 
