diff --git a/tests/test_api.py b/tests/test_api.py
index b5f31bc..aca2fde 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -224,6 +224,27 @@ def test_integer() -> None:
     assert isinstance(i, Integer)
 
 
+@pytest.mark.parametrize(
+    "raw, value",
+    [("1_000", 1000), ("5_349_221", 5349221), ("53_49_221", 5349221), ("1_2_3", 123)],
+)
+def test_integer_preserves_underscores(raw: str, value: int) -> None:
+    i = tomlkit.integer(raw)
+
+    assert i.as_string() == raw
+    assert int(i) == value
+
+    doc = tomlkit.document()
+    doc["n"] = i
+    assert tomlkit.dumps(doc) == f"n = {raw}\n"
+    assert tomlkit.parse(tomlkit.dumps(doc))["n"] == value
+
+
+def test_integer_normalizes_non_toml_strings() -> None:
+    assert tomlkit.integer(" 34 ").as_string() == "34"
+    assert tomlkit.integer("007").as_string() == "7"
+
+
 def test_float() -> None:
     i = tomlkit.float_("34.56")
 
