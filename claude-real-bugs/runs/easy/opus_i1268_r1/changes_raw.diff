 class SeekableTest(PeekableMixinTests, TestCase):
     cls = mi.seekable
 
+    def test_maxlen_zero_peek_bool(self):
+        s = mi.seekable([10, 20, 30], maxlen=0)
+        self.assertEqual(s.peek(), 10)
+        self.assertEqual(s.peek(), 10)
+        self.assertTrue(s)
+        self.assertEqual(list(s.elements()), [])
+        self.assertEqual(next(s), 10)
+        self.assertTrue(s)
+        self.assertEqual(list(s), [20, 30])
+        self.assertFalse(s)
+        self.assertEqual(s.peek('x'), 'x')
+
+        s = mi.seekable([10, 20, 30], maxlen=0)
+        s.peek()
+        s.seek(1)
+        self.assertEqual(list(s), [20, 30])
