index 2dfeffe..3681da4 100644
--- a/src/humanize/number.py
+++ b/src/humanize/number.py
@@ -550,8 +550,12 @@ def metric(value: float, unit: str = "", precision: int = 3) -> str:
     old_bucket = exponent // 3 * 3
     value /= 10**old_bucket
     digits = int(max(0, precision - exponent % 3 - 1))
-    if exponent < 30 and round(abs(value), digits) >= 1000:
-        exponent += 3 - exponent % 3
+    # Rounding may carry the mantissa up a power of ten (e.g. 9.999 -> 10.00);
+    # bump the exponent so the number of significant figures stays the same.
+    if round(abs(value), digits) >= 10 ** (exponent % 3 + 1) and (
+        exponent % 3 != 2 or exponent < 30
+    ):
+        exponent += 1
         new_bucket = exponent // 3 * 3
         value /= 10 ** (new_bucket - old_bucket)
         digits = int(max(0, precision - exponent % 3 - 1))
