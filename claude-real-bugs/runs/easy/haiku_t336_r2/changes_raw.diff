diff --git a/tests/test_api.py b/tests/test_api.py
index b5f31bc..dea7018 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -224,6 +224,18 @@ def test_integer() -> None:
     assert isinstance(i, Integer)
 
 
+def test_integer_keeps_underscores_when_dumped() -> None:
+    i = tomlkit.integer("1_000")
+
+    assert i.as_string() == "1_000"
+    assert int(i) == 1000
+
+    doc = tomlkit.document()
+    doc["n"] = i
+
+    assert tomlkit.dumps(doc) == "n = 1_000\n"
+
+
 def test_float() -> None:
     i = tomlkit.float_("34.56")
 
diff --git a/tomlkit/api.py b/tomlkit/api.py
index b0f8cd6..6166bee 100644
--- a/tomlkit/api.py
+++ b/tomlkit/api.py
@@ -115,7 +115,14 @@ def document() -> TOMLDocument:
 
 # Items
 def integer(raw: str | int) -> Integer:
-    """Create an integer item from a number or string."""
+    """Create an integer item from a number or string.
+
+    A string keeps its original spelling when dumped, so underscore
+    separators such as ``"1_000"`` are preserved.
+    """
+    if isinstance(raw, str):
+        raw = raw.strip()
+        return Integer(int(raw), Trivia(), raw)
     return item(int(raw))
 
 
