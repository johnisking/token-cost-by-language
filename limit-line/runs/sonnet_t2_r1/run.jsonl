\n\n  var layouts = [\n    function (r, c) { return r < 4; },\n    function (r, c) { return r < 6 && (r + c) % 2 === 0; },\n    function (r, c) { return r < 6 && c >= r && c < COLS - r; },\n    function (r, c) { return r < 7 && r % 2 === 0; },\n    function (r, c) { return r < 8 && (r === 0 || r === 7 || c === 0 || c === COLS - 1 || c === r || c === COLS - 1 - r); }\n  ];\n\n  var save = load();\n  var state = { level: save.level, score: save.score, lives: 3, best: save.best, mode: 'play', paused: false };\n  var bricks = [], paddle = { w: 90, h: 12, x: W / 2 - 45, y: H - 30 }, ball = { x: 0, y: 0, r: 7, dx: 0, dy: 0, launched: false };\n  var keys = { left: false, right: false };\n\n  function load() {\n    var s = { level: 1, score: 0, best: 0 };\n    try {\n      var o = JSON.parse(localStorage.getItem(KEY));\n      if (o) {\n        s.level = Math.min(MAXLEVEL, Math.max(1, o.level | 0));\n        s.score = Math.max(0, o.score | 0);\n        s.best = Math.max(0, o.best | 0);\n      }\n    } catch (e) {}\n    return s;\n  }\n  function persist() {\n    try { localStorage.setItem(KEY, JSON.stringify({ level: state.level, score: state.score, best: state.best })); } catch (e) {}\n  }\n\n  function buildLevel() {\n    bricks = [];\n    var f = layouts[state.level - 1];\n    for (var r = 0; r < ROWS; r++)\n      for (var c = 0; c < COLS; c++)\n        if (f(r, c)) bricks.push({ x: OX + c * (BW + GAP), y: OY + r * (BH + GAP), w: BW, h: BH, row: r });\n    resetBall();\n  }\n  function resetBall() {\n    ball.launched = false; ball.dx = 0; ball.dy = 0;\n    ball.x = paddle.x + paddle.w / 2; ball.y = paddle.y - ball.r;\n  }\n  function launch() {\n    if (ball.launched) return;\n    var sp = 4.5 + state.level * 0.5;\n    ball.launched = true;\n    ball.dx = sp * 0.5 * (Math.random() < 0.5 ? -1 : 1);\n    ball.dy = -Math.sqrt(sp * sp - ball.dx * ball.dx);\n  }\n\n  function addScore(n) {\n    state.score += n;\n    if (state.score > state.best) state.best = state.score;\n    persist();\n  }\n  function nextLevel() {\n    if (state.level >= MAXLEVEL) { finish('win'); return; }\n    state.level++;\n    persist();\n    buildLevel();\n  }\n  function finish(mode) {\n    state.mode = mode;\n    state.level = 1; state.score = 0;\n    persist();\n  }\n  function restart() {\n    state.mode = 'play'; state.lives = 3; state.level = 1; state.score = 0; state.paused = false;\n    persist();\n    buildLevel();\n  }\n\n  function update() {\n    if (state.mode !== 'play' || state.paused) return;\n    var sp = 7;\n    if (keys.left) paddle.x -= sp;\n    if (keys.right) paddle.x += sp;\n    paddle.x = Math.max(0, Math.min(W - paddle.w, paddle.x));\n    if (!ball.launched) { ball.x = paddle.x + paddle.w / 2; ball.y = paddle.y - ball.r; return; }\n\n    var speed = Math.hypot(ball.dx, ball.dy), steps = Math.ceil(speed / 3);\n    for (var s = 0; s < steps; s++) {\n      ball.x += ball.dx / steps; ball.y += ball.dy / steps;\n      if (ball.x < ball.r) { ball.x = ball.r; ball.dx = Math.abs(ball.dx); }\n      if (ball.x > W - ball.r) { ball.x = W - ball.r; ball.dx = -Math.abs(ball.dx); }\n      if (ball.y < ball.r) { ball.y = ball.r; ball.dy = Math.abs(ball.dy); }\n\n      if (ball.dy > 0 && ball.y + ball.r >= paddle.y && ball.y + ball.r <= paddle.y + paddle.h + 8 &&\n          ball.x >= paddle.x - ball.r && ball.x <= paddle.x + paddle.w + ball.r) {\n        var t = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);\n        t = Math.max(-1, Math.min(1, t));\n        var ang = t * 1.1;\n        ball.dx = speed * Math.sin(ang);\n        ball.dy = -speed * Math.cos(ang);\n        ball.y = paddle.y - ball.r;\n      }\n\n      for (var i = 0; i < bricks.length; i++) {\n        var b = bricks[i];\n        var cx = Math.max(b.x, Math.min(ball.x, b.x + b.w)), cy = Math.max(b.y, Math.min(ball.y, b.y + b.h));\n        var dx = ball.x - cx, dy = ball.y - cy;\n        if (dx * dx + dy * dy <= ball.r * ball.r) {\n          var ox = Math.min(ball.x + ball.r - b.x, b.x + b.w - (ball.x - ball.r));\n          var oy = Math.min(ball.y + ball.r - b.y, b.y + b.h - (ball.y - ball.r));\n          if (ox < oy) ball.dx = -ball.dx; else ball.dy = -ball.dy;\n          bricks.splice(i, 1);\n          addScore(10 * (ROWS - b.row));\n          break;\n        }\n      }\n      if (bricks.length === 0) { nextLevel(); return; }\n\n      if (ball.y - ball.r > H) {\n        state.lives--;\n        if (state.lives <= 0) { state.lives = 0; finish('over'); }\n        else resetBall();\n        return;\n      }\n    }\n  }\n\n  function draw() {\n    ctx.clearRect(0, 0, W, H);\n    var hues = [0, 30, 55, 120, 200, 270, 310, 340];\n    bricks.forEach(function (b) {\n      ctx.fillStyle = 'hsl(' + hues[b.row % 8] + ',70%,55%)';\n      ctx.fillRect(b.x, b.y, b.w, b.h);\n    });\n    ctx.fillStyle = '#ddd';\n    ctx.fillRect(paddle.x, paddle.y, paddle.w, paddle.h);\n    ctx.beginPath(); ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();\n\n    document.getElementById('score').textContent = 'Score: ' + state.score;\n    document.getElementById('lives').textContent = 'Lives: ' + state.lives;\n    document.getElementById('level').textContent = 'Level: ' + state.level;\n    document.getElementById('best').textContent = 'Best: ' + state.best;\n\n    var m = '', s = '';\n    if (state.mode === 'win') { m = 'You win'; s = 'Press Space or click to play again'; }\n    else if (state.mode === 'over') { m = 'Game over'; s = 'Press Space or click to play again'; }\n    else if (state.paused) { m = 'Paused'; s = 'Press P to resume'; }\n    overlay.style.display = m ? 'flex' : 'none';\n    msg.textContent = m; sub.textContent = s;\n  }\n\n  function loop() { update(); draw(); requestAnimationFrame(loop); }\n\n  function action() {\n    if (state.mode !== 'play') { restart(); return; }\n    if (!state.paused) launch();\n  }\n\n  document.addEventListener('keydown', function (e) {\n    var k = e.key;\n    if (k === 'ArrowLeft') { keys.left = true; e.preventDefault(); }\n    else if (k === 'ArrowRight') { keys.right = true; e.preventDefault(); }\n    else if (k === ' ' || k === 'Spacebar') { e.preventDefault(); action(); }\n    else if (k === 'p' || k === 'P') { if (state.mode === 'play') state.paused = !state.paused; }\n    else if (k === 'n' || k === 'N') { if (state.mode === 'play' && !state.paused) nextLevel(); }\n  });\n  document.addEventListener('keyup', function (e) {\n    if (e.key === 'ArrowLeft') keys.left = false;\n    else if (e.key === 'ArrowRight') keys.right = false;\n  });\n  cv.addEventListener('mousemove', function (e) {\n    if (state.mode !== 'play' || state.paused) return;\n    var rect = cv.getBoundingClientRect();\n    paddle.x = Math.max(0, Math.min(W - paddle.w, (e.clientX - rect.left) * (W / rect.width) - paddle.w / 2));\n  });\n  document.getElementById('wrap').addEventListener('mousedown', action);\n  window.addEventListener('blur', function () { keys.left = keys.right = false; });\n\n  buildLevel();\n  loop();\n})();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9244,"cache_read_input_tokens":11993,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9244},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5b783884-d708-4c9a-8e16-de6bcb68bcfc","uuid":"a34e2cd4-448d-4858-a5b3-fe71edad9e35","timestamp":"2026-10-23T07:51:19.210Z","request_id":"req_011CgJoatpeNw6BH2tFQNVVe"}
