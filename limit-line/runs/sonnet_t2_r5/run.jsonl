R_TOP = 50;\n  var BR_LEFT = (W - (BR_COLS * BR_W + (BR_COLS - 1) * BR_GAP)) / 2;\n  var PAD_W = 90, PAD_H = 12, PAD_Y = H - 30, PAD_SPEED = 480;\n  var BALL_R = 7;\n\n  var state = {\n    score: 0, lives: 3, level: 1, best: 0,\n    mode: 'ready',   // ready (waiting launch), playing, over, win\n    paused: false\n  };\n  var bricks = [];\n  var pad = { x: (W - PAD_W) / 2 };\n  var ball = { x: 0, y: 0, vx: 0, vy: 0 };\n  var keys = { left: false, right: false };\n\n  function load() {\n    try {\n      var d = JSON.parse(localStorage.getItem(KEY) || '{}');\n      if (d.best > 0) state.best = d.best | 0;\n      if (d.level >= 1 && d.level <= LEVELS.length) state.level = d.level | 0;\n      if (d.level && d.score > 0) state.score = d.score | 0;\n      if (d.lives >= 1 && d.lives <= 3) state.lives = d.lives | 0;\n    } catch (e) {}\n  }\n  function save() {\n    try {\n      localStorage.setItem(KEY, JSON.stringify({\n        level: state.level, score: state.score, lives: state.lives, best: state.best\n      }));\n    } catch (e) {}\n  }\n\n  function buildLevel() {\n    bricks = [];\n    var rows = LEVELS[state.level - 1];\n    for (var r = 0; r < rows.length; r++) {\n      for (var c = 0; c < BR_COLS; c++) {\n        var ch = rows[r][c];\n        if (ch === '.') continue;\n        var hp = ch === '#' ? 1 : parseInt(ch, 10);\n        bricks.push({\n          x: BR_LEFT + c * (BR_W + BR_GAP),\n          y: BR_TOP + r * (BR_H + BR_GAP),\n          hp: hp, color: COLORS[r % COLORS.length], alive: true\n        });\n      }\n    }\n  }\n\n  function resetBall() {\n    state.mode = state.mode === 'playing' || state.mode === 'ready' ? 'ready' : state.mode;\n    ball.x = pad.x + PAD_W / 2;\n    ball.y = PAD_Y - BALL_R - 1;\n    ball.vx = ball.vy = 0;\n  }\n\n  function startLevel() {\n    buildLevel();\n    state.mode = 'ready';\n    resetBall();\n  }\n\n  function newGame() {\n    state.score = 0; state.lives = 3; state.level = 1;\n    state.paused = false;\n    startLevel();\n    save();\n  }\n\n  function nextLevel() {\n    if (state.level >= LEVELS.length) {\n      state.mode = 'win';\n      // finished: next session starts fresh\n      state.level = 1; state.score = state.score; // keep score displayed on win screen\n      try {\n        localStorage.setItem(KEY, JSON.stringify({ level: 1, score: 0, lives: 3, best: state.best }));\n      } catch (e) {}\n      return;\n    }\n    state.level++;\n    startLevel();\n    save();\n  }\n\n  function addScore(n) {\n    state.score += n;\n    if (state.score > state.best) state.best = state.score;\n    save();\n  }\n\n  function launch() {\n    if (state.mode === 'over' || state.mode === 'win') { newGame(); return; }\n    if (state.paused) return;\n    if (state.mode === 'ready') {\n      var speed = 300 + (state.level - 1) * 30;\n      var a = (Math.random() * 0.6 - 0.3);\n      ball.vx = speed * Math.sin(a);\n      ball.vy = -speed * Math.cos(a);\n      state.mode = 'playing';\n    }\n  }\n\n  function loseLife() {\n    state.lives--;\n    if (state.lives <= 0) {\n      state.lives = 0;\n      state.mode = 'over';\n      try {\n        localStorage.setItem(KEY, JSON.stringify({ level: 1, score: 0, lives: 3, best: state.best }));\n      } catch (e) {}\n      return;\n    }\n    state.mode = 'ready';\n    resetBall();\n    save();\n  }\n\n  function clampPad() {\n    if (pad.x < 0) pad.x = 0;\n    if (pad.x > W - PAD_W) pad.x = W - PAD_W;\n  }\n\n  function update(dt) {\n    if (state.paused || state.mode === 'over' || state.mode === 'win') return;\n    var dir = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);\n    pad.x += dir * PAD_SPEED * dt;\n    clampPad();\n\n    if (state.mode === 'ready') {\n      ball.x = pad.x + PAD_W / 2;\n      ball.y = PAD_Y - BALL_R - 1;\n      return;\n    }\n\n    // sub-step to avoid tunnelling\n    var steps = 3;\n    for (var s = 0; s < steps; s++) {\n      ball.x += ball.vx * dt / steps;\n      ball.y += ball.vy * dt / steps;\n\n      if (ball.x < BALL_R) { ball.x = BALL_R; ball.vx = Math.abs(ball.vx); }\n      if (ball.x > W - BALL_R) { ball.x = W - BALL_R; ball.vx = -Math.abs(ball.vx); }\n      if (ball.y < BALL_R) { ball.y = BALL_R; ball.vy = Math.abs(ball.vy); }\n\n      // paddle\n      if (ball.vy > 0 && ball.y + BALL_R >= PAD_Y && ball.y + BALL_R <= PAD_Y + PAD_H + 6 &&\n          ball.x >= pad.x - BALL_R && ball.x <= pad.x + PAD_W + BALL_R) {\n        var hit = (ball.x - (pad.x + PAD_W / 2)) / (PAD_W / 2); // -1..1\n        hit = Math.max(-1, Math.min(1, hit));\n        var sp = Math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy);\n        var ang = hit * 1.05; // radians from vertical\n        ball.vx = sp * Math.sin(ang);\n        ball.vy = -sp * Math.cos(ang);\n        ball.y = PAD_Y - BALL_R;\n      }\n\n      // bricks\n      for (var i = 0; i < bricks.length; i++) {\n        var b = bricks[i];\n        if (!b.alive) continue;\n        var cx = Math.max(b.x, Math.min(ball.x, b.x + BR_W));\n        var cy = Math.max(b.y, Math.min(ball.y, b.y + BR_H));\n        var dx = ball.x - cx, dy = ball.y - cy;\n        if (dx * dx + dy * dy > BALL_R * BALL_R) continue;\n\n        var ox = Math.min(ball.x + BALL_R - b.x, b.x + BR_W - (ball.x - BALL_R));\n        var oy = Math.min(ball.y + BALL_R - b.y, b.y + BR_H - (ball.y - BALL_R));\n        if (ox < oy) ball.vx = (ball.x < b.x + BR_W / 2) ? -Math.abs(ball.vx) : Math.abs(ball.vx);\n        else ball.vy = (ball.y < b.y + BR_H / 2) ? -Math.abs(ball.vy) : Math.abs(ball.vy);\n\n        b.hp--;\n        if (b.hp <= 0) { b.alive = false; addScore(10 * state.level); }\n        else addScore(5);\n        break;\n      }\n\n      if (ball.y - BALL_R > H) { loseLife(); return; }\n    }\n\n    if (!bricks.some(function (b) { return b.alive; })) nextLevel();\n  }\n\n  function statusLines() {\n    return ['Score: ' + state.score, 'Lives: ' + state.lives, 'Level: ' + state.level, 'Best: ' + state.best];\n  }\n\n  function overlay(text, sub) {\n    ctx.fillStyle = 'rgba(0,0,0,0.65)';\n    ctx.fillRect(0, 0, W, H);\n    ctx.fillStyle = '#fff';\n    ctx.textAlign = 'center';\n    ctx.font = 'bold 48px sans-serif';\n    ctx.fillText(text, W / 2, H / 2);\n    if (sub) { ctx.font = '18px sans-serif'; ctx.fillText(sub, W / 2, H / 2 + 36); }\n  }\n\n  function draw() {\n    ctx.clearRect(0, 0, W, H);\n\n    // status bar\n    var lines = statusLines();\n    ctx.font = '16px sans-serif';\n    ctx.fillStyle = '#eee';\n    ctx.textBaseline = 'alphabetic';\n    ctx.textAlign = 'left'; ctx.fillText(lines[0], 12, 26);\n    ctx.textAlign = 'center'; ctx.fillText(lines[1], W * 0.4, 26);\n    ctx.fillText(lines[2], W * 0.6, 26);\n    ctx.textAlign = 'right'; ctx.fillText(lines[3], W - 12, 26);\n    ctx.strokeStyle = '#444';\n    ctx.beginPath(); ctx.moveTo(0, 36); ctx.lineTo(W, 36); ctx.stroke();\n    var txt = lines.join(' | ');\n    if (sr.textContent !== txt) sr.textContent = txt;\n\n    bricks.forEach(function (b) {\n      if (!b.alive) return;\n      ctx.fillStyle = b.hp > 1 ? '#95a5a6' : b.color;\n      ctx.fillRect(b.x, b.y, BR_W, BR_H);\n      if (b.hp > 1) {\n        ctx.fillStyle = '#222'; ctx.font = 'bold 13px sans-serif'; ctx.textAlign = 'center';\n        ctx.fillText(String(b.hp), b.x + BR_W / 2, b.y + 15);\n      }\n    });\n\n    ctx.fillStyle = '#ecf0f1';\n    ctx.fillRect(pad.x, PAD_Y, PAD_W, PAD_H);\n    ctx.beginPath(); ctx.arc(ball.x, ball.y, BALL_R, 0, Math.PI * 2);\n    ctx.fillStyle = '#f9ca24'; ctx.fill();\n\n    if (state.mode === 'ready' && !state.paused) {\n      ctx.fillStyle = '#aaa'; ctx.font = '16px sans-serif'; ctx.textAlign = 'center';\n      ctx.fillText('Press Space or click to launch', W / 2, H / 2 + 80);\n    }\n    if (state.mode === 'over') overlay('Game over', 'Press Space or click to restart');\n    else if (state.mode === 'win') overlay('You win', 'Press Space or click to play again');\n    else if (state.paused) overlay('Paused', 'Press P to resume');\n  }\n\n  var last = performance.now();\n  function frame(now) {\n    var dt = Math.min(0.033, (now - last) / 1000);\n    last = now;\n    update(dt);\n    draw();\n    requestAnimationFrame(frame);\n  }\n\n  document.addEventListener('keydown', function (e) {\n    var k = e.key;\n    if (k === 'ArrowLeft') { keys.left = true; e.preventDefault(); }\n    else if (k === 'ArrowRight') { keys.right = true; e.preventDefault(); }\n    else if (k === ' ' || k === 'Spacebar') { e.preventDefault(); launch(); }\n    else if (k === 'p' || k === 'P') {\n      if (state.mode !== 'over' && state.mode !== 'win') state.paused = !state.paused;\n    }\n    else if (k === 'n' || k === 'N') {\n      if (state.mode !== 'over' && state.mode !== 'win' && !state.paused) nextLevel();\n    }\n  });\n  document.addEventListener('keyup', function (e) {\n    if (e.key === 'ArrowLeft') keys.left = false;\n    else if (e.key === 'ArrowRight') keys.right = false;\n  });\n  canvas.addEventListener('mousemove', function (e) {\n    if (state.paused) return;\n    var r = canvas.getBoundingClientRect();\n    var x = (e.clientX - r.left) * (W / r.width);\n    pad.x = x - PAD_W / 2;\n    clampPad();\n  });\n  canvas.addEventListener('mousedown', function () { launch(); });\n  window.addEventListener('blur', function () { keys.left = keys.right = false; });\n\n  load();\n  startLevel();\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_018rHoTHeKJ4JGs6D573g6XF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
