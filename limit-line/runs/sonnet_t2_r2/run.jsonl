 4: columns\n    (r, c) => r === 0 || r === 6 || c === 0 || c === COLS - 1 || (r > 1 && r < 5 && c > 2 && c < 7) // 5: frame + core\n  ];\n  const colors = ['#e74c3c', '#e67e22', '#f1c40f', '#2ecc71', '#3498db', '#9b59b6', '#1abc9c'];\n\n  const load = (k) => { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } };\n  const store = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };\n\n  let level = 1, score = 0, lives = 3, best = 0;\n  let bricks = [], state = 'ready', prevState = 'ready';\n  const paddle = { w: 90, h: 12, x: W / 2 - 45, y: H - 30 };\n  const ball = { x: 0, y: 0, vx: 0, vy: 0, r: 7 };\n  const keys = { left: false, right: false };\n\n  const saved = load(SAVE_KEY);\n  if (saved && saved.level >= 1 && saved.level <= MAX_LEVEL) {\n    level = saved.level | 0;\n    score = saved.score | 0;\n    lives = saved.lives >= 1 && saved.lives <= 3 ? saved.lives | 0 : 3;\n  }\n  const b = load(BEST_KEY);\n  best = typeof b === 'number' ? b : 0;\n\n  function save() { store(SAVE_KEY, { level, score, lives }); store(BEST_KEY, best); }\n\n  function buildLevel() {\n    bricks = [];\n    const f = layouts[level - 1];\n    for (let r = 0; r < ROWS; r++)\n      for (let c = 0; c < COLS; c++)\n        if (f(r, c)) bricks.push({ x: LEFT + c * (BW + GAP), y: TOP + r * (BH + GAP), color: colors[r % colors.length] });\n  }\n\n  function resetBall() {\n    ball.x = paddle.x + paddle.w / 2;\n    ball.y = paddle.y - ball.r - 1;\n    ball.vx = ball.vy = 0;\n    state = 'ready';\n  }\n\n  function startLevel(n) {\n    level = n;\n    buildLevel();\n    resetBall();\n    save();\n  }\n\n  function newGame() {\n    score = 0; lives = 3;\n    startLevel(1);\n  }\n\n  function nextLevel() {\n    if (level >= MAX_LEVEL) {\n      state = 'win';\n      store(SAVE_KEY, { level: 1, score: 0, lives: 3 });\n      store(BEST_KEY, best);\n    } else startLevel(level + 1);\n  }\n\n  function launch() {\n    if (state !== 'ready') return;\n    const speed = 5 + level * 0.5;\n    const a = (Math.random() * 0.6 - 0.3);\n    ball.vx = speed * Math.sin(a);\n    ball.vy = -speed * Math.cos(a);\n    state = 'playing';\n  }\n\n  function addScore(n) {\n    score += n;\n    if (score > best) best = score;\n  }\n\n  function loseLife() {\n    lives--;\n    if (lives <= 0) {\n      lives = 0;\n      state = 'over';\n      store(SAVE_KEY, { level: 1, score: 0, lives: 3 });\n      store(BEST_KEY, best);\n    } else {\n      resetBall();\n      save();\n    }\n  }\n\n  function movePaddle(x) {\n    paddle.x = Math.max(0, Math.min(W - paddle.w, x));\n    if (state === 'ready') ball.x = paddle.x + paddle.w / 2;\n  }\n\n  function update() {\n    if (state === 'paused' || state === 'over' || state === 'win') return;\n    const k = 7;\n    if (keys.left) movePaddle(paddle.x - k);\n    if (keys.right) movePaddle(paddle.x + k);\n    if (state !== 'playing') return;\n\n    // sub-step to avoid tunnelling\n    const steps = Math.ceil(Math.hypot(ball.vx, ball.vy) / 4);\n    for (let s = 0; s < steps; s++) {\n      ball.x += ball.vx / steps;\n      ball.y += ball.vy / steps;\n      if (ball.x < ball.r) { ball.x = ball.r; ball.vx = Math.abs(ball.vx); }\n      if (ball.x > W - ball.r) { ball.x = W - ball.r; ball.vx = -Math.abs(ball.vx); }\n      if (ball.y < ball.r) { ball.y = ball.r; ball.vy = Math.abs(ball.vy); }\n\n      if (ball.vy > 0 && ball.y + ball.r >= paddle.y && ball.y - ball.r <= paddle.y + paddle.h &&\n          ball.x >= paddle.x - ball.r && ball.x <= paddle.x + paddle.w + ball.r) {\n        const speed = Math.hypot(ball.vx, ball.vy);\n        const rel = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);\n        const a = Math.max(-1, Math.min(1, rel)) * 1.05;\n        ball.vx = speed * Math.sin(a);\n        ball.vy = -speed * Math.cos(a);\n        ball.y = paddle.y - ball.r - 0.5;\n      }\n\n      for (let i = 0; i < bricks.length; i++) {\n        const br = bricks[i];\n        if (ball.x + ball.r > br.x && ball.x - ball.r < br.x + BW && ball.y + ball.r > br.y && ball.y - ball.r < br.y + BH) {\n          const ox = Math.min(ball.x + ball.r - br.x, br.x + BW - (ball.x - ball.r));\n          const oy = Math.min(ball.y + ball.r - br.y, br.y + BH - (ball.y - ball.r));\n          if (ox < oy) ball.vx = -ball.vx; else ball.vy = -ball.vy;\n          bricks.splice(i, 1);\n          addScore(10 * level);\n          break;\n        }\n      }\n      if (bricks.length === 0) { save(); nextLevel(); return; }\n      if (ball.y - ball.r > H) { loseLife(); return; }\n    }\n    if (state === 'playing') save();\n  }\n\n  function overlay(text, sub) {\n    ctx.fillStyle = 'rgba(0,0,0,0.65)';\n    ctx.fillRect(0, 0, W, H);\n    ctx.fillStyle = '#fff';\n    ctx.textAlign = 'center';\n    ctx.font = 'bold 48px sans-serif';\n    ctx.fillText(text, W / 2, H / 2);\n    if (sub) { ctx.font = '18px sans-serif'; ctx.fillText(sub, W / 2, H / 2 + 36); }\n  }\n\n  function draw() {\n    ctx.clearRect(0, 0, W, H);\n    for (const br of bricks) { ctx.fillStyle = br.color; ctx.fillRect(br.x, br.y, BW, BH); }\n    ctx.fillStyle = '#ddd';\n    ctx.fillRect(paddle.x, paddle.y, paddle.w, paddle.h);\n    ctx.beginPath(); ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();\n\n    ctx.font = '16px sans-serif';\n    ctx.fillStyle = '#fff';\n    ctx.textAlign = 'left';  ctx.fillText('Score: ' + score, 10, 24);\n    ctx.textAlign = 'center'; ctx.fillText('Lives: ' + lives, W * 0.35, 24);\n    ctx.fillText('Level: ' + level, W * 0.55, 24);\n    ctx.textAlign = 'right'; ctx.fillText('Best: ' + best, W - 10, 24);\n\n    if (state === 'ready') {\n      ctx.font = '16px sans-serif'; ctx.fillStyle = '#aab'; ctx.textAlign = 'center';\n      ctx.fillText('Press Space or click to launch', W / 2, H / 2 + 60);\n    } else if (state === 'paused') overlay('Paused', 'Press P to resume');\n    else if (state === 'over') overlay('Game over', 'Press Space or click to restart');\n    else if (state === 'win') overlay('You win', 'Press Space or click to play again');\n\n    const t = `Score: ${score} Lives: ${lives} Level: ${level} Best: ${best}` +\n      (state === 'paused' ? ' Paused' : state === 'over' ? ' Game over' : state === 'win' ? ' You win' : '');\n    if (hud.textContent !== t) hud.textContent = t;\n  }\n\n  function action() {\n    if (state === 'over' || state === 'win') newGame();\n    else launch();\n  }\n\n  function togglePause() {\n    if (state === 'paused') state = prevState;\n    else if (state === 'playing' || state === 'ready') { prevState = state; state = 'paused'; }\n  }\n\n  addEventListener('keydown', (e) => {\n    const k = e.key;\n    if (k === 'ArrowLeft') { keys.left = true; e.preventDefault(); }\n    else if (k === 'ArrowRight') { keys.right = true; e.preventDefault(); }\n    else if (k === ' ' || k === 'Spacebar') { e.preventDefault(); action(); }\n    else if (k === 'p' || k === 'P') togglePause();\n    else if (k === 'n' || k === 'N') {\n      if (state !== 'paused' && state !== 'over' && state !== 'win') nextLevel();\n    }\n  });\n  addEventListener('keyup', (e) => {\n    if (e.key === 'ArrowLeft') keys.left = false;\n    else if (e.key === 'ArrowRight') keys.right = false;\n  });\n  cv.addEventListener('mousemove', (e) => {\n    if (state === 'paused' || state === 'over' || state === 'win') return;\n    const rect = cv.getBoundingClientRect();\n    movePaddle((e.clientX - rect.left) * (W / rect.width) - paddle.w / 2);\n  });\n  cv.addEventListener('click', action);\n  addEventListener('blur', () => { keys.left = keys.right = false; });\n\n  buildLevel();\n  resetBall();\n  save();\n\n  (function loop() { update(); draw(); requestAnimationFrame(loop); })();\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01QbAmntemV3vE7sYhyh9gL8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
