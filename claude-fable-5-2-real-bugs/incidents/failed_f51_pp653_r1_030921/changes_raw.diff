+    # History of matches of ``expr`` (opening) and ``rep`` (closing), as
+    # (location, is_opening, tokens) tuples, kept in increasing location
+    # order. Keeping a history rather than a single "last match" lets the
+    # repeater be used repeatedly and in nested constructs (each closing
+    # match pairs with the innermost unclosed opening match). Whenever a
+    # new match occurs at location ``loc``, any recorded matches at or
+    # beyond ``loc`` belong to abandoned (backtracked) parse branches or to
+    # a previous parse, so they are discarded; this also resets the state
+    # when a new parse starts after a failed one.
+    history: list[tuple[int, bool, list]] = []
+
+    def discard_from(loc: int) -> None:
+        while history and history[-1][0] >= loc:
+            history.pop()
 
-        e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    def copy_token_to_repeater(s, l, t):
+        discard_from(l)
+        history.append((l, True, _flatten(t.as_list())))
+
+    def must_match_these_tokens(s, l, t):
+        discard_from(l)
+        unclosed: list[list] = []
+        for _, is_opening, toks in history:
+            if is_opening:
+                unclosed.append(toks)
+            elif unclosed:
+                unclosed.pop()
+        if not unclosed:
+            raise ParseException(s, l, f"No previous match of {expr} to repeat")
+        match_tokens = unclosed[-1]
+        these_tokens = _flatten(t.as_list())
+        if these_tokens != match_tokens:
+            raise ParseException(
+                s, l, f"Expected {match_tokens}, found {these_tokens}"
+            )
+        history.append((l, False, these_tokens))
 
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
     return rep
 
