+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr in nested, repeated, and re-parsed contexts"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        open_tag = pp.Suppress("{") + name + pp.Suppress("}")
+        close_tag = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        content = pp.Forward()
+        content <<= open_tag + pp.ZeroOrMore(content | pp.Word("x")) + close_tag
+
+        # simplest case
+        self.assertParseAndCheckList(content, "{a}xx{/a}", ["a", "xx", "a"])
+
+        # nested tags - each closing tag must match the innermost open tag
+        self.assertParseAndCheckList(
+            content, "{a}{b}xx{/b}{/a}", ["a", "b", "xx", "b", "a"]
+        )
+        with self.assertRaisesParseException(msg="mis-nested tags should fail"):
+            content.parse_string("{a}{b}xx{/a}{/b}", parse_all=True)
+
+        # sequential pairs under OneOrMore
+        self.assertParseAndCheckList(
+            pp.OneOrMore(pp.Group(content)),
+            "{a}x{/a}{b}x{/b}",
+            [["a", "x", "a"], ["b", "x", "b"]],
+        )
+
+        # a failed parse must not poison subsequent parses of valid input
+        with self.assertRaisesParseException(msg="mismatched tag should fail"):
+            content.parse_string("{a}xx{/b}", parse_all=True)
+        self.assertParseAndCheckList(content, "{a}xx{/a}", ["a", "xx", "a"])
+        self.assertParseAndCheckList(content, "{b}xx{/b}", ["b", "xx", "b"])
+
