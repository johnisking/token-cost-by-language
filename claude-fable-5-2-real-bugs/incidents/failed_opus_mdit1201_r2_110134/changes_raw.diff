+
+describe('Backticks cache', function () {
+  it('unclosed link/image label should not suppress later code span', function () {
+    for (const preset of ['default', 'commonmark', 'zero']) {
+      const md = markdownit(preset)
+      assert.strictEqual(md.render('[foo `bar` baz`'), '<p>[foo <code>bar</code> baz`</p>\n')
+      assert.strictEqual(md.render('![alt `code` x`'), '<p>![alt <code>code</code> x`</p>\n')
+      assert.strictEqual(md.render('[`a`b`'), '<p>[<code>a</code>b`</p>\n')
+      assert.strictEqual(md.render('[``a`` `b` ``'), '<p>[<code>a</code> <code>b</code> ``</p>\n')
+    }
+  })
+})
