+const NUMERIC_KEY_KEYWORDS = ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf"];
+
+// the json a schema will hold once finalize has merged in what its wrappers inherit
+function inheritedJSON(schema: schemas.$ZodType, ctx: ToJSONSchemaContext): JSONSchema.BaseSchema {
+  const seen = ctx.seen.get(schema);
+  if (!seen) return {};
+  const ref = seen.ref;
+  if (!ref || ref === schema._zod.parent) return seen.schema;
+  return { ...inheritedJSON(ref, ctx), ...seen.schema };
+}
+
+// property names are always strings, so a numeric key schema is restated over the strings that spell those numbers; returns its argument when nothing in it is numeric
+function stringifyKeySchema(json: JSONSchema.BaseSchema): JSONSchema.BaseSchema {
+  const out = { ...json };
+  let changed = false;
+
+  for (const key of ["anyOf", "oneOf", "allOf"] as const) {
+    const members = json[key];
+    if (!Array.isArray(members)) continue;
+    const mapped = members.map((m) =>
+      m && typeof m === "object" ? stringifyKeySchema(m as JSONSchema.BaseSchema) : m
+    );
+    if (mapped.every((m, i) => m === members[i])) continue;
+    out[key] = mapped as any;
+    changed = true;
+  }
+
+  const numericEnum = Array.isArray(json.enum) && json.enum.some((v) => typeof v === "number");
+  if (numericEnum) {
+    const values = [...new Set(json.enum!.map((v) => (typeof v === "number" ? String(v) : v)))];
+    out.enum = values;
+    if (values.every((v) => typeof v === "string")) out.type = "string";
+    changed = true;
+  }
+  const numericConst = typeof json.const === "number";
+  if (numericConst) {
+    out.const = String(json.const);
+    out.type = "string";
+    changed = true;
+  }
+
+  if (json.type === "number" || json.type === "integer") {
+    out.type = "string";
+    // a range has no string form, so only the shape of the number survives
+    for (const keyword of NUMERIC_KEY_KEYWORDS) delete out[keyword];
+    if (!numericEnum && !numericConst) out.pattern = (json.type === "integer" ? integerRegex : numberRegex).source;
+    changed = true;
+  }
+  return changed ? out : json;
+}
