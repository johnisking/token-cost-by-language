+  test("record with numeric keys describes property names as strings", () => {
+    const names = (key: z.core.$ZodRecordKey) => z.toJSONSchema(z.record(key, z.boolean())).propertyNames;
+    const number = { type: "string", pattern: "^-?\\d+(?:\\.\\d+)?$" };
+
+    expect(names(z.number())).toEqual(number);
+    expect(names(z.number().min(1).describe("id"))).toEqual({ ...number, description: "id" });
+    expect(names(z.int().readonly())).toEqual({ type: "string", pattern: "^-?\\d+$", readOnly: true });
+    expect(names(z.literal(1))).toEqual({ type: "string", const: "1" });
+    expect(names(z.literal([1, "a"]))).toEqual({ type: "string", enum: ["1", "a"] });
+    expect(names(z.union([z.number(), z.literal("a")]))).toEqual({ anyOf: [number, { type: "string", const: "a" }] });
+
+    // the key schema itself is still numeric wherever else it appears
+    const shared = z.number();
+    expect(z.toJSONSchema(z.record(shared, shared)).additionalProperties).toEqual({ type: "number" });
+    expect(z.toJSONSchema(z.record(z.literal(1), z.string()), { target: "draft-04" }).required).toEqual(["1"]);
+  });
+
