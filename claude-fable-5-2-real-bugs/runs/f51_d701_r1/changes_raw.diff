 import type { StructuredPatch } from '../types.js';
 
+/**
+ * Returns true if the line at index `i` in `lines` has no line ending at all - i.e. it is
+ * immediately followed by a "\ No newline at end of file" marker. Any trailing '\r' on such a line
+ * is part of the line's content rather than part of a CRLF line ending, so it must neither be used
+ * as evidence that the patch has Windows line endings nor be stripped when converting to Unix.
+ */
+function hasNoLineEnding(lines: string[], i: number): boolean {
+  return !!lines[i + 1]?.startsWith('\\');
+}
