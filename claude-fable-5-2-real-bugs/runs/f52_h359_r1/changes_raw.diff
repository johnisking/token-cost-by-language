@@ -550,11 +550,19 @@ def metric(value: float, unit: str = "", precision: int = 3) -> str:
     old_bucket = exponent // 3 * 3
     value /= 10**old_bucket
     digits = int(max(0, precision - exponent % 3 - 1))
-    if exponent < 30 and round(abs(value), digits) >= 1000:
-        exponent += 3 - exponent % 3
-        new_bucket = exponent // 3 * 3
-        value /= 10 ** (new_bucket - old_bucket)
-        digits = int(max(0, precision - exponent % 3 - 1))
+    # Rounding to the displayed digits may carry the mantissa up a power of ten
+    # (e.g. 9.999 -> 10.00), which would show one significant figure too many.
+    if round(abs(value), digits) >= 10 ** (exponent % 3 + 1):
+        if exponent % 3 != 2:
+            # Same prefix, one more integer digit: drop one decimal.
+            exponent += 1
+            digits = int(max(0, precision - exponent % 3 - 1))
+        elif exponent < 30:
+            # Carried up to 1000: move to the next prefix.
+            exponent += 1
+            new_bucket = exponent // 3 * 3
+            value /= 10 ** (new_bucket - old_bucket)
+            digits = int(max(0, precision - exponent % 3 - 1))
 
     if exponent >= 3:
         ordinal_ = "kMGTPEZYRQ"[exponent // 3 - 1]
