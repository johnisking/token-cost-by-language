+  /**
+   * Mask reference links so their text cannot pair with em/strong/del
+   * delimiters outside of them. The result has the same length as `src`.
+   */
+  private maskReflinks(src: string): string {
+    return src.replace(this.tokenizer.rules.inline.reflinkSearch, (match0: string, label?: string) => {
+      if (!Object.hasOwn(this.tokens.links, match0.slice(match0.lastIndexOf('[') + 1, -1))) {
+        return match0;
+      }
+      // A link whose text holds another link is rejected by the tokenizer: its
+      // brackets become text and its text is tokenized in place, so the
+      // delimiters in it must stay visible. Only what is still a link inside
+      // it (and the trailing `[ref]`, which becomes a link of its own) is masked.
+      if (label && match0.charAt(0) !== '!' && label.includes('[') && this.linkTextHasLink(label)) {
+        const labelEnd = 1 + label.length;
+        return '[' + this.maskReflinks(label) + ']' + this.maskReflinks(match0.slice(labelEnd + 1));
+      }
+      return '[' + 'a'.repeat(match0.length - 2) + ']';
+    });
+  }
+
+  /**
+   * Whether tokenizing `text` as the text of a link produces a link, which
+   * makes the tokenizer reject the outer link.
+   */
+  private linkTextHasLink(text: string): boolean {
+    const { inLink, linkEmitted, inRawBlock } = this.state;
+    this.state.inLink = true;
+    this.state.linkEmitted = false;
+    this.inlineTokens(text.replace(this.tokenizer.rules.other.outputLinkReplace, '$1'));
+    const hasLink = this.state.linkEmitted;
+    this.state.inLink = inLink;
+    this.state.linkEmitted = linkEmitted;
+    this.state.inRawBlock = inRawBlock;
+    return hasLink;
+  }
+
