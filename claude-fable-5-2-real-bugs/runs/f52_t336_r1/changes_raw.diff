@@ -116,6 +117,13 @@ def document() -> TOMLDocument:
 # Items
 def integer(raw: str | int) -> Integer:
     """Create an integer item from a number or string."""
+    if isinstance(raw, str) and "_" in raw:
+        # Keep the digit grouping when the string is a valid TOML decimal
+        # integer (an underscore must have a digit on each side, and leading
+        # zeros are not allowed). Anything else is normalized as before.
+        if re.fullmatch(r"[+-]?(?:0|[1-9](?:_?[0-9])*)", raw):
+            return Integer(int(raw), Trivia(), raw)
+
     return item(int(raw))
 
 
