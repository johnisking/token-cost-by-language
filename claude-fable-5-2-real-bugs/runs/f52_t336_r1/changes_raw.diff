@@ -611,3 +611,23 @@ def test_parse_accepts_nesting_at_the_depth_limit() -> None:
     assert parse(array).as_string() == array
     dotted = ".".join(["a"] * depth) + " = 1"
     assert parse(dotted).as_string() == dotted
+
+
+def test_integer_from_string_keeps_underscores():
+    i = tomlkit.integer("1_000")
+    assert i.as_string() == "1_000"
+    assert int(i) == 1000
+    assert i == 1000
+
+    doc = tomlkit.document()
+    doc["n"] = tomlkit.integer("1_000")
+    doc["m"] = tomlkit.integer("-53_49_221")
+    assert tomlkit.dumps(doc) == "n = 1_000\nm = -53_49_221\n"
+    assert tomlkit.parse(tomlkit.dumps(doc)) == dict(n=1000, m=-5349221)
+
+    assert tomlkit.integer("1000").as_string() == "1000"
+    assert tomlkit.integer(1000).as_string() == "1000"
+    # Not a valid TOML literal: normalized as before
+    assert tomlkit.integer("0_1").as_string() == "1"
+    with pytest.raises(ValueError):
+        tomlkit.integer("1__000")
