+test("breaks a cycle that closes through a merged catchall", () => {
+  const Node: any = z.object({ id: z.number() }).merge(z.object({}).catchall(z.lazy(() => Node)));
+
+  const input: any = { id: 1 };
+  input.self = input;
+
+  const result = Node.parse(input);
+  expect(result.id).toBe(1);
+  expect(result.self).toBe(result);
+});
