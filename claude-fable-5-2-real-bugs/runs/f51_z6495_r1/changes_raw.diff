diff --git a/packages/zod/src/v4/classic/tests/default.test.ts b/packages/zod/src/v4/classic/tests/default.test.ts
index d7ff8b4..21a467a 100644
--- a/packages/zod/src/v4/classic/tests/default.test.ts
+++ b/packages/zod/src/v4/classic/tests/default.test.ts
@@ -5,6 +5,22 @@ test("basic defaults", () => {
   expect(z.string().default("default").parse(undefined)).toBe("default");
 });
 
+test("default factory runs once per parse inside an object", async () => {
+  let calls = 0;
+  const schema = z.object({
+    a: z.string().default(() => {
+      calls++;
+      return "d";
+    }),
+  });
+  expect(schema.parse({})).toEqual({ a: "d" });
+  expect(calls).toBe(1);
+  await schema.parseAsync({});
+  expect(calls).toBe(2);
+  schema.parse({}, { jitless: true });
+  expect(calls).toBe(3);
+});
+
