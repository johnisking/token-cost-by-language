 # Items
 def integer(raw: str | int) -> Integer:
-    """Create an integer item from a number or string."""
-    return item(int(raw))
+    """Create an integer item from a number or string.
+
+    If a string using a valid TOML decimal representation is given
+    (e.g. ``"1_000"``), its formatting is preserved when dumping.
+    """
+    value = int(raw)
+    if isinstance(raw, str):
+        stripped = raw.strip()
+        if _DECIMAL_INTEGER_RE.match(stripped):
+            return Integer(value, Trivia(), stripped)
+
+    return item(value)
+
+
+_DECIMAL_INTEGER_RE = re.compile(r"^[+\-]?(?:0|[1-9](?:_?[0-9])*)$")
 
 
