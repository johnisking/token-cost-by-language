diff --git a/tests/test_api.py b/tests/test_api.py
index b5f31bc..eb3d462 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -224,6 +224,36 @@ def test_integer() -> None:
     assert isinstance(i, Integer)
 
 
+@pytest.mark.parametrize(
+    "raw,expected",
+    [
+        ("1_000", 1000),
+        ("5_349_221", 5349221),
+        ("53_49_221", 5349221),
+        ("1_2_3_4_5", 12345),
+        ("+1_000", 1000),
+        ("-1_000", -1000),
+    ],
+)
+def test_integer_preserves_underscores(raw: str, expected: int) -> None:
+    i = tomlkit.integer(raw)
+
+    assert isinstance(i, Integer)
+    assert int(i) == expected
+    assert i.as_string() == raw
+
+    doc = tomlkit.document()
+    doc["n"] = i
+    assert tomlkit.dumps(doc) == f"n = {raw}\n"
+    assert tomlkit.parse(tomlkit.dumps(doc))["n"] == expected
+
+
+def test_integer_normalizes_non_toml_strings() -> None:
+    assert tomlkit.integer("010").as_string() == "10"
+    assert tomlkit.integer(" 42 ").as_string() == "42"
+    assert (tomlkit.integer("+1_000") + 1).as_string() == "+1001"
+
+
 def test_float() -> None:
