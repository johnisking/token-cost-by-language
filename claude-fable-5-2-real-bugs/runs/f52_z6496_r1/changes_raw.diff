+const numericKeywords = ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf"] as const;
+
+// property names are always strings, so numeric parts of a key schema become the strings they accept; returns the input itself when nothing is numeric
+function keyNameSchema(json: JSONSchema.BaseSchema): JSONSchema.BaseSchema {
+  const out: JSONSchema.BaseSchema = { ...json };
+  let changed = false;
+  if (json.type === "number" || json.type === "integer") {
+    changed = true;
+    out.type = "string";
+    for (const keyword of numericKeywords) delete out[keyword];
+    if (!("const" in json) && !json.enum) {
+      out.pattern = (json.type === "integer" ? regexes.integer : regexes.number).source;
+    }
+  }
+  if (typeof json.const === "number") {
+    changed = true;
+    out.const = `${json.const}`;
+  }
+  if (json.enum?.some((value) => typeof value === "number")) {
+    changed = true;
+    out.enum = json.enum.map((value) => (typeof value === "number" ? `${value}` : value));
+  }
+  for (const keyword of ["anyOf", "oneOf"] as const) {
+    const options = json[keyword];
+    if (!options) continue;
+    const mapped = options.map((option) => keyNameSchema(option as JSONSchema.BaseSchema));
+    if (mapped.some((option, i) => option !== options[i])) {
+      changed = true;
+      out[keyword] = mapped;
+    }
+  }
+  return changed ? out : json;
+}
