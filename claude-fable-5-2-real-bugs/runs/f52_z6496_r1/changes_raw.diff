+
+test("record with numeric keys emits string propertyNames", () => {
+  const names = (key: z.core.$ZodRecordKey) => z.toJSONSchema(z.record(key, z.string()));
+  const number = { type: "string", pattern: "^-?\\d+(?:\\.\\d+)?$" };
+  expect(names(z.number().min(0)).propertyNames).toEqual(number);
+  expect(names(z.int()).propertyNames).toEqual({ type: "string", pattern: "^-?\\d+$" });
+  expect(names(z.literal(1))).toMatchObject({ propertyNames: { type: "string", const: "1" }, required: ["1"] });
+  expect(names(z.literal([1, 2])).propertyNames).toEqual({ type: "string", enum: ["1", "2"] });
+  expect(names(z.union([z.number(), z.literal("a")])).propertyNames).toEqual({
+    anyOf: [number, { type: "string", const: "a" }],
+  });
+
+  // a key schema reused as a value keeps its numeric form
+  const key = z.number();
+  expect(z.toJSONSchema(z.object({ a: key, b: z.record(key, key) })).properties).toEqual({
+    a: { type: "number" },
+    b: { type: "object", propertyNames: number, additionalProperties: { type: "number" } },
+  });
+});
