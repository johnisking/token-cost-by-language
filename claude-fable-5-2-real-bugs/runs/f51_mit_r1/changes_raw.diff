diff --git a/tests/test_more.py b/tests/test_more.py
index 7440f5a..be1207a 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -3136,6 +3136,30 @@ class NumericRangeTests(TestCase):
             with self.assertRaises(ValueError):
                 mi.numeric_range(*args).index(v)
 
+    def test_float_consistency(self):
+        # len(), indexing, `in`, index(), count() and reversed() must all
+        # agree with the items produced by iteration, even for floats.
+        for args in [
+            (-8.732, -13.532, -2.4),
+            (-69.37276490678778, -29.8339073344664, 4.942357196540172),
+            (0.0, 1.0, 0.1),
+            (0.0, 0.7, 0.1),
+            (1.0, 0.0, -0.1),
+        ]:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                items = list(r)
+                self.assertEqual(len(r), len(items))
+                self.assertEqual(list(reversed(r)), items[::-1])
+                self.assertEqual([r[i] for i in range(len(r))], items)
+                with self.assertRaises(IndexError):
+                    r[len(r)]
+                for i, v in enumerate(items):
+                    self.assertIn(v, r)
+                    self.assertEqual(r.index(v), i)
+                    self.assertEqual(r.count(v), 1)
+                self.assertNotIn(r._stop, r)
+
     def test_parent_classes(self):
         r = mi.numeric_range(7.0)
         self.assertTrue(isinstance(r, Iterable))
