 class IchunkedTests(TestCase):
+    def test_zero(self):
+        self.assertEqual(list(mi.ichunked([], 0)), [])
+        iterator = iter(['a', 'b', 'c'])
+        self.assertEqual(list(mi.ichunked(iterator, 0)), [])
+        # Matches chunked: nothing is consumed from the source
+        self.assertEqual(list(iterator), ['a', 'b', 'c'])
+
+    def test_negative(self):
+        for iterable in ([], ['a', 'b', 'c']):
+            with self.assertRaisesRegex(ValueError, 'n must be at least 0'):
+                mi.ichunked(iterable, -1)
+
     def test_even(self):
         iterable = (str(x) for x in range(10))
         actual = [''.join(c) for c in mi.ichunked(iterable, 5)]
