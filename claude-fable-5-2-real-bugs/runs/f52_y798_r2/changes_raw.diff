diff --git a/src/ast/styler_defaults.ts b/src/ast/styler_defaults.ts
index d61ce64..07bbdbb 100644
--- a/src/ast/styler_defaults.ts
+++ b/src/ast/styler_defaults.ts
@@ -64,6 +64,10 @@ function applyForceQuotesOption (layout: ScalarLayout): void {
   // forceQuotes applies only to plain values, not to mapping keys.
   if (layout.isKey || layout.style !== SCALAR_STYLE.PLAIN) return
 
+  // forceQuotes applies only to strings. Quoting other scalars (booleans,
+  // numbers, null, ...) would require explicit tags to preserve their types.
+  if (layout.node.tag !== layout.presenterOptions.schema.defaultScalarTag.tagName) return
+
   layout.style = layout.node.value.includes('\n')
     ? SCALAR_STYLE.DOUBLE_QUOTED
     : _preferredQuotedStyle(layout)
diff --git a/test/core/units/dump-options.test.mjs b/test/core/units/dump-options.test.mjs
index 71aa336..65eb0ed 100644
--- a/test/core/units/dump-options.test.mjs
+++ b/test/core/units/dump-options.test.mjs
@@ -102,6 +102,20 @@ describe('dump options', () => {
     )
   })
 
+  it('forceQuotes — does not quote non-string scalars', () => {
+    assert.equal(
+      dump(
+        { bool: true, integer: 42, float: 3.14, nil: null, text: 'true' },
+        { forceQuotes: true, quoteStyle: 'double' }
+      ),
+      'bool: true\ninteger: 42\nfloat: 3.14\nnil: null\ntext: "true"\n'
+    )
+    assert.equal(
+      dump([true, 1, null, 'a'], { forceQuotes: true, flowLevel: 0 }),
+      "[true, 1, null, 'a']\n"
+    )
+  })
+
   it('flowLevel — switches to flow style from the given depth', () => {
     assert.equal(dump({ a: [1, 2] }), 'a:\n  - 1\n  - 2\n')
     assert.equal(dump({ a: [1, 2] }, { flowLevel: 0 }), '{a: [1, 2]}\n')
