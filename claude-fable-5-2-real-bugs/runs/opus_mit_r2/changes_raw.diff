diff --git a/tests/test_more.py b/tests/test_more.py
index 7440f5a..4f2b288 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -3174,6 +3174,45 @@ class NumericRangeTests(TestCase):
     def test_empty_reversed(self):
         self.assertEqual(list(reversed(mi.numeric_range(0))), [])
 
+    def _assert_self_consistent(self, r):
+        items = list(r)
+        self.assertEqual(len(r), len(items))
+        self.assertEqual(list(reversed(r)), items[::-1])
+        with self.assertRaises(IndexError):
+            r[len(items)]
+        for i, v in enumerate(items):
+            self.assertEqual(r[i], v)
+            self.assertIn(v, r)
+            self.assertEqual(r.index(v), items.index(v))
+            self.assertEqual(r.count(v), items.count(v))
+
+    def test_float_consistency(self):
+        for args, expected_len in [
+            ((-8.732, -13.532, -2.4), 2),
+            ((-69.37276490678778, -29.8339073344664, 4.942357196540172), 9),
+            ((0.0, 1.0, 0.1), 10),
+            ((1e16, 1e16 + 40, 0.1), None),  # duplicated items
+        ]:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                if expected_len is not None:
+                    self.assertEqual(len(r), expected_len)
+                self._assert_self_consistent(r)
+
+        r = mi.numeric_range(0.0, 1.0, 0.1)
+        self.assertIn(r[3], r)
+        self.assertEqual(r.index(r[3]), 3)
+        self.assertEqual(r.count(r[3]), 1)
+        self.assertNotIn(0.3, r)  # 0.3 != 0.1 * 3
+
+    def test_float_consistency_random(self):
+        rng = Random(0)
+        for _ in range(2000):
+            start = rng.uniform(-100, 100)
+            stop = rng.uniform(-100, 100)
+            step = rng.uniform(-10, 10) or 1.0
+            self._assert_self_consistent(mi.numeric_range(start, stop, step))
+
 
