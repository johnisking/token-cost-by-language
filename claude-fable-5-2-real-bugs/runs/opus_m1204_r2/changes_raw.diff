diff --git a/src/markdownit.ts b/src/markdownit.ts
index 4dc2ce9..9e90649 100644
--- a/src/markdownit.ts
+++ b/src/markdownit.ts
@@ -162,6 +162,23 @@ class MarkdownIt {
       }
     }
 
+    if (parsed.hostname && parsed.hostname.indexOf(':') !== -1) {
+      // IPv6 address literal: brackets around the host must stay literal
+      // (WHATWG URL requires `[` and `]`, `%5B...%5D` is an invalid host),
+      // so encode the parts around the host separately.
+      const head = (parsed.protocol || '') +
+        (parsed.slashes ? '//' : '') +
+        (parsed.auth ? parsed.auth + '@' : '')
+      const tail = (parsed.port ? ':' + parsed.port : '') +
+        (parsed.pathname || '') +
+        (parsed.search || '') +
+        (parsed.hash || '')
+
+      return mdurl.encode(head) +
+        '[' + mdurl.encode(parsed.hostname) + ']' +
+        mdurl.encode(tail)
+    }
+
     return mdurl.encode(mdurl.format(parsed))
   }
 
