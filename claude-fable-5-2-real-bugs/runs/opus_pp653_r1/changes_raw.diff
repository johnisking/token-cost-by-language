+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr with nested, repeated, and re-parsed matches"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        tag = pp.Word(pp.alphas)
+        open_tag = pp.Suppress("{") + tag + pp.Suppress("}")
+        close_tag = pp.Suppress("{/") + pp.match_previous_expr(tag) + pp.Suppress("}")
+        element = pp.Forward()
+        element <<= pp.Group(open_tag + pp.ZeroOrMore(element | pp.Word("x")) + close_tag)
+
+        tests = [
+            ("{a}xx{/a}", [["a", "xx", "a"]]),
+            ("{a}{b}xx{/b}{/a}", [["a", ["b", "xx", "b"], "a"]]),
+            ("{a}{b}x{/b}{c}x{/c}{/a}", [["a", ["b", "x", "b"], ["c", "x", "c"], "a"]]),
+            ("{a}{b}xx{/a}{/b}", None),
+            ("{a}xx{/b}", None),
+            ("{a}xx{/a}", [["a", "xx", "a"]]),
+            ("{a}{b}xx{/b}{/a}", [["a", ["b", "xx", "b"], "a"]]),
+        ]
+        for tst, expected in tests:
+            if expected is None:
+                with self.assertRaisesParseException(msg=f"expected fail: {tst!r}"):
+                    element.parse_string(tst, parse_all=True)
+            else:
+                self.assertParseAndCheckList(element, tst, expected)
+
+        first = pp.Word(pp.alphas)
+        seq = pp.OneOrMore(pp.Group(first + ":" + pp.match_previous_expr(first)))
+        tests = [
+            ("a:a b:b", [["a", ":", "a"], ["b", ":", "b"]]),
+            ("a:a b:a", None),
+            ("a:b", None),
+            ("a:a b:b c:c", [["a", ":", "a"], ["b", ":", "b"], ["c", ":", "c"]]),
+        ]
+        for tst, expected in tests:
+            if expected is None:
+                with self.assertRaisesParseException(msg=f"expected fail: {tst!r}"):
+                    seq.parse_string(tst, parse_all=True)
+            else:
+                self.assertParseAndCheckList(seq, tst, expected)
+
     def testRecursiveCombine(self):
         testInput = "myc(114)r(11)dd"
         stream = pp.Forward()
