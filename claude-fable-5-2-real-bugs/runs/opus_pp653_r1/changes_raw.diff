-                raise ParseException(
-                    s, l, f"Expected {match_tokens}, found{these_tokens}"
-                )
+    # Matches of ``expr`` are recorded on a stack, so that nested and repeated
+    # pairs are each matched against their own opening expression. Each entry
+    # is [input string, match location, matched tokens, location where the
+    # entry was matched by the repeat (or None if not matched yet)].
+    # Entries left over from abandoned (backtracked) parse attempts, or from
+    # parsing a different input string, are discarded based on locations.
+    matches: list = []
+
+    def _prune(s, l):
+        # discard entries from other input strings, or from alternatives that
+        # started at or after the current location (they were backtracked)
+        while matches and (matches[-1][0] is not s or matches[-1][1] >= l):
+            matches.pop()
+        if matches and matches[0][0] is not s:
+            matches[:] = [m for m in matches if m[0] is s and m[1] < l]
+        # repeat matches at or after the current location were also backtracked
+        for m in matches:
+            if m[3] is not None and m[3] >= l:
+                m[3] = None
 
-        e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    def copy_token_to_repeater(s, l, t):
+        _prune(s, l)
+        matches.append([s, l, _flatten(t.as_list()), None])
+
+    def must_match_these_tokens(s, l, t):
+        _prune(s, l)
+        these_tokens = _flatten(t.as_list())
+        target = next((m for m in reversed(matches) if m[3] is None), None)
+        if target is None:
+            # all previous matches already repeated; compare to the most recent
+            target = matches[-1] if matches else None
+        if target is None:
+            # nothing to compare against (``expr`` has not matched yet)
+            return
+        match_tokens = target[2]
+        if these_tokens != match_tokens:
+            raise ParseException(
+                s, l, f"Expected {match_tokens}, found {these_tokens}"
+            )
+        if target[3] is None:
+            target[3] = l
 
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
     return rep
