+  test("record with numeric keys emits string propertyNames", () => {
+    const num = z.number().min(0);
+    const keys = (key: z.core.$ZodRecordKey) => z.toJSONSchema(z.record(key, z.number())).propertyNames;
+    expect(keys(num)).toEqual({ type: "string", pattern: "^-?\\d+(?:\\.\\d+)?$" });
+    expect(keys(z.int())).toEqual({ type: "string", pattern: "^-?\\d+$" });
+    expect(keys(z.literal(1))).toEqual({ type: "string", const: "1" });
+    expect(keys(z.union([z.number(), z.string().max(3)]))).toEqual({
+      anyOf: [{ type: "string", pattern: "^-?\\d+(?:\\.\\d+)?$" }, { type: "string", maxLength: 3 }],
+    });
+    // shared numeric schema stays numeric elsewhere
+    expect(z.toJSONSchema(z.object({ a: z.record(num, z.string()), b: num })).properties!.b).toEqual({
+      type: "number",
+      minimum: 0,
+    });
+    expect(z.toJSONSchema(z.record(z.string(), z.number())).propertyNames).toEqual({ type: "string" });
+  });
+
