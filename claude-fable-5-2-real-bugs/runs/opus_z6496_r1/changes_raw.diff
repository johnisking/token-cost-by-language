+const NUMERIC_KEYWORDS = ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf"] as const;
+
+// json property names are always strings, so numeric key schemas become the numeric strings record parsing accepts; returns the input untouched when nothing is numeric
+function stringKeySchema(json: JSONSchema._JSONSchema): JSONSchema._JSONSchema {
+  if (typeof json !== "object" || json === null) return json;
+  let out = json as JSONSchema.BaseSchema;
+  const set = (key: string, value: unknown) => {
+    if (out === json) out = { ...json };
+    (out as any)[key] = value;
+  };
+
+  const type = json.type;
+  const types = Array.isArray(type) ? type : type === undefined ? [] : [type];
+  if (types.includes("number") || types.includes("integer")) {
+    const next = [...new Set(types.map((t) => (t === "number" || t === "integer" ? "string" : t)))];
+    set("type", next.length === 1 ? next[0] : next);
+    for (const key of NUMERIC_KEYWORDS) delete (out as any)[key];
+    if (!types.includes("string") && json.const === undefined && json.enum === undefined) {
+      set("pattern", (types.includes("number") ? regexes.number : regexes.integer).source);
+    }
+  }
+  if (typeof json.const === "number") set("const", String(json.const));
+  if (Array.isArray(json.enum) && json.enum.some((v) => typeof v === "number")) {
+    set("enum", [...new Set(json.enum.map((v) => (typeof v === "number" ? String(v) : v)))]);
+  }
+  for (const key of ["anyOf", "oneOf", "allOf"] as const) {
+    const members = json[key];
+    if (!Array.isArray(members)) continue;
+    const mapped = members.map(stringKeySchema);
+    if (mapped.some((m, i) => m !== members[i])) set(key, mapped);
+  }
+  return out;
+}
