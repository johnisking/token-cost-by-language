+/**
+ * Check whether a token list contains a bracketed link (inline link or
+ * reference link) at any level of nesting. Autolinks and GFM urls do not
+ * count, matching CommonMark.
+ */
+function containsLink(tokens: Token[] | undefined): boolean {
+  if (!tokens) {
+    return false;
+  }
+  for (const token of tokens) {
+    if (token.type === 'link' && typeof token.raw === 'string' && token.raw.charAt(0) === '[') {
+      return true;
+    }
+    if (containsLink((token as Tokens.Generic).tokens)) {
+      return true;
+    }
+  }
+  return false;
+}
