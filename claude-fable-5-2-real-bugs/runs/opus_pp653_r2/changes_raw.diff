+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr with nested, repeated, and re-run matches"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        open_tag = pp.Suppress("{") + name + pp.Suppress("}")
+        close_tag = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        element = pp.Forward()
+        element <<= open_tag + (pp.Word("x") | element) + close_tag
+        elements = pp.OneOrMore(element)
+
+        tests = [
+            ("{a}xx{/a}", True),
+            ("{a}{b}xx{/b}{/a}", True),
+            ("{a}{b}{c}xx{/c}{/b}{/a}", True),
+            ("{a}xx{/a}{b}xx{/b}", True),
+            ("{a}{b}xx{/a}{/b}", False),
+            ("{a}{b}xx{/b}{/b}", False),
+            ("{a}xx{/b}", False),
+            ("{a}xx{/a}{b}xx{/a}", False),
+            ("{c}xx{/c}", True),
+            ("{a}{b}xx{/b}{/a}", True),
+        ]
+        for tst, expected in tests:
+            self.assertEqual(
+                expected,
+                elements.matches(tst, parse_all=True),
+                msg=f"nested repeater test failed for {tst!r}",
+            )
+
+        word = pp.Word(pp.alphas)
+        pair = pp.Group(word + ":" + pp.match_previous_expr(word))
+        self.assertParseAndCheckList(
+            pp.OneOrMore(pair),
+            "a:a b:b",
+            [["a", ":", "a"], ["b", ":", "b"]],
+        )
+        with self.assertRaisesParseException():
+            pp.OneOrMore(pair).parse_string("a:a b:c", parse_all=True)
+        self.assertParseAndCheckList(
+            pp.OneOrMore(pair),
+            "c:c d:d",
+            [["c", ":", "c"], ["d", ":", "d"]],
+        )
+
