+    # Log of (loc, tokens) events along the current parse path: tokens is the
+    # list of flattened tokens for a match of expr ("open"), or None for a
+    # successful match of the repeater ("close").  Replaying the log as a
+    # stack gives the expected tokens for the innermost unclosed match of
+    # expr, which supports nested and repeated use.  Events at or beyond the
+    # current location belong to abandoned (backtracked) parse paths, and are
+    # discarded before recording or evaluating a new event.
+    state = {"string": None, "events": []}
+
+    def _events_before(s, l):
+        if state["string"] is not s:
+            state["string"] = s
+            state["events"] = []
+        events = state["events"]
+        while events and events[-1][0] >= l:
+            events.pop()
+        return events
 
-        e2.add_parse_action(must_match_these_tokens, call_during_try=True)
+    def copy_token_to_repeater(s, l, t):
+        events = _events_before(s, l)
+        events.append((l, _flatten(t.as_list())))
+
+    def must_match_these_tokens(s, l, t):
+        events = _events_before(s, l)
+        stack = []
+        for _, toks in events:
+            if toks is None:
+                if stack:
+                    stack.pop()
+            else:
+                stack.append(toks)
+        if not stack:
+            raise ParseException(s, l, f"Expected a previous match of {expr}")
+        match_tokens = stack[-1]
+        these_tokens = _flatten(t.as_list())
+        if these_tokens != match_tokens:
+            raise ParseException(
+                s, l, f"Expected {match_tokens}, found{these_tokens}"
+            )
+        events.append((l, None))
 
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
     rep.set_name(f"(prev) {expr}")
     return rep
