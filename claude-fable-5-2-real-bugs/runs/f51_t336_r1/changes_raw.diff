diff --git a/tests/test_api.py b/tests/test_api.py
index b5f31bc..09de38e 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -222,6 +222,46 @@ def test_integer() -> None:
     i = tomlkit.integer("34")
 
     assert isinstance(i, Integer)
+    assert i == 34
+    assert i.as_string() == "34"
+
+
+@pytest.mark.parametrize(
+    ("raw", "value"),
+    [
+        ("1_000", 1000),
+        ("5_349_221", 5349221),
+        ("53_49_221", 5349221),
+        ("1_2_3_4_5", 12345),
+        ("+1_000", 1000),
+        ("-1_000", -1000),
+        ("0xdead_beef", 0xDEADBEEF),
+        ("0o7_55", 0o755),
+        ("0b1_0", 2),
+    ],
+)
+def test_integer_preserves_raw_literal(raw: str, value: int) -> None:
+    i = tomlkit.integer(raw)
+
+    assert isinstance(i, Integer)
+    assert int(i) == value
+    assert i.as_string() == raw
+
+    doc = tomlkit.document()
+    doc["n"] = i
+    assert tomlkit.dumps(doc) == f"n = {raw}\n"
+    assert tomlkit.parse(tomlkit.dumps(doc))["n"] == value
+
+
+def test_integer_from_non_literal_string_falls_back_to_int() -> None:
+    i = tomlkit.integer(" 42 ")
+
+    assert isinstance(i, Integer)
+    assert i == 42
+    assert i.as_string() == "42"
+
+    with pytest.raises(ValueError):
+        tomlkit.integer("1__000")
 
 
