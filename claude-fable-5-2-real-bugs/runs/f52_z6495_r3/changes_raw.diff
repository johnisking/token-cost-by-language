+
+test("default and prefault factories run once per absent object key", () => {
+  let calls = 0;
+  const factory = () => `v${calls++}`;
+  const schema = z.object({
+    a: z.string().default(factory),
+    b: z.string().prefault(factory),
+    c: z.array(z.string().default(factory)),
+  });
+  expect(schema.parse({ c: [undefined] })).toEqual({ a: "v0", b: "v1", c: ["v2"] });
+  expect(schema.parse({ a: "x", c: [] })).toEqual({ a: "x", b: "v3", c: [] });
+  expect(calls).toBe(4);
+});
