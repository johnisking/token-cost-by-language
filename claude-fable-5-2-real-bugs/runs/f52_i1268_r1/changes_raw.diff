+    def test_maxlen_zero_peek_and_bool(self):
+        s = mi.seekable([10, 20, 30], maxlen=0)
+        self.assertEqual(s.peek(), 10)
+        self.assertEqual(s.peek(), 10)
+        self.assertTrue(s)
+        self.assertEqual(next(s), 10)
+        self.assertTrue(s)
+        self.assertEqual(list(s), [20, 30])
+        self.assertEqual(list(s.elements()), [])
+        self.assertFalse(s)
+        self.assertEqual(s.peek('default'), 'default')
+        self.assertRaises(StopIteration, s.peek)
+
+        # A peeked item still counts as the next item when seeking
+        s = mi.seekable([10, 20, 30], maxlen=0)
+        s.peek()
+        s.seek(2)
+        self.assertEqual(list(s), [30])
+
