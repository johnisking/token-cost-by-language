+// object keys are always strings, so a numeric key schema is emitted as the string form the record parser retries as Number(key); range checks have no string equivalent and are dropped
+function stringifyKeySchema(json: JSONSchema.BaseSchema): JSONSchema.BaseSchema {
+  const type = json.type;
+  if (type !== "number" && type !== "integer") {
+    for (const keyword of ["anyOf", "oneOf"] as const) {
+      const options = json[keyword];
+      if (!Array.isArray(options)) continue;
+      const mapped = options.map(stringifyKeySchema);
+      if (mapped.some((o, i) => o !== options[i])) return { ...json, [keyword]: mapped };
+    }
+    return json;
+  }
+  const out: JSONSchema.StringSchema = { ...(json as JSONSchema.BaseSchema), type: "string" };
+  for (const keyword of ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf", "format"]) {
+    delete (out as JSONSchema.BaseSchema)[keyword];
+  }
+  if (json.const !== undefined) out.const = String(json.const);
+  else if (json.enum) out.enum = json.enum.map(String);
+  else out.pattern = (type === "integer" ? regexes.integer : regexes.number).source;
+  return out;
+}
