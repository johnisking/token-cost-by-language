+  test("record with numeric keys emits string propertyNames", () => {
+    expect(z.toJSONSchema(z.record(z.number(), z.number())).propertyNames).toEqual({
+      type: "string",
+      pattern: "^-?\\d+(?:\\.\\d+)?$",
+    });
+    // range checks have no string form and are dropped; annotations survive
+    expect(z.toJSONSchema(z.record(z.int().min(1).describe("id"), z.number())).propertyNames).toEqual({
+      type: "string",
+      pattern: "^-?\\d+$",
+      description: "id",
+    });
+    expect(z.toJSONSchema(z.record(z.literal(1), z.number()))).toMatchObject({
+      propertyNames: { type: "string", const: "1" },
+      required: ["1"],
+    });
+    expect(z.toJSONSchema(z.record(z.literal([1, 2]), z.number()), { target: "draft-07" })).toMatchObject({
+      propertyNames: { type: "string", enum: ["1", "2"] },
+      required: ["1", "2"],
+    });
+    expect(z.toJSONSchema(z.record(z.union([z.literal("a"), z.literal(1)]), z.number())).propertyNames).toEqual({
+      anyOf: [
+        { type: "string", const: "a" },
+        { type: "string", const: "1" },
+      ],
+    });
+    // string keys are untouched
+    expect(z.toJSONSchema(z.record(z.string().min(2), z.number())).propertyNames).toEqual({
+      type: "string",
+      minLength: 2,
+    });
+  });
