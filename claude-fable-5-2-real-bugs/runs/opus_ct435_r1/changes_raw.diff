+++ b/tests/test_cachedmethod.py
@@ -690,3 +690,40 @@ class AutospecTest(unittest.TestCase):
             warnings.simplefilter("always")
             unittest.mock.create_autospec(Cached, instance=True)
         self.assertEqual(len(w), 0)
+
+
+class ClassAccessTest(unittest.TestCase):
+    NAMES = (
+        "get",
+        "get_typed",
+        "get_info",
+        "get_lock",
+        "get_lock_info",
+        "get_cond",
+        "get_cond_info",
+        "get_lock_cond",
+        "get_lock_cond_info",
+    )
+
+    def test_class_access_with_instance(self):
+        for name in self.NAMES:
+            with self.subTest(name=name):
+                cached = Cached(Cache(maxsize=2))
+                method = getattr(Cached, name)
+                self.assertEqual(method(cached, 0), 0)
+                self.assertEqual(method(cached, 0), 0)
+                self.assertEqual(getattr(cached, name)(0), 0)
+                self.assertEqual(getattr(cached, name)(1), 1)
+                self.assertEqual(method(cached, 1), 1)
+                self.assertEqual(len(cached.cache), 2)
+                if name.endswith("_info"):
+                    self.assertEqual(getattr(cached, name).cache_info().hits, 3)
+
+    def test_class_access_keyword_arguments(self):
+        cached = Cached(Cache(maxsize=2))
+        self.assertEqual(Cached.get(cached, value=0), 0)
+        self.assertEqual(cached.get(value=0), 0)
+
+    def test_class_access_introspection(self):
+        self.assertEqual(Cached.get.__name__, "get")
+        self.assertEqual(Cached.get.__doc__, "docstring")
