@@ -763,6 +763,93 @@ class TestHTMLBlocks(TestCase):
             )
         )
 
+    def test_comment_in_inline_raw_html(self):
+        # A comment inside an unclosed inline tag must not start a raw block.
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture>
+                """
+            ),
+            self.dedent(
+                """
+                <p><picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture></p>
+                """
+            )
+        )
+
+    def test_comment_in_inline_raw_html_nested(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <span><em>
+                <!-- comment -->
+                </em>
+                <!-- comment -->
+                </span>
+                <!-- comment -->
+                *bar*
+                """
+            ),
+            self.dedent(
+                """
+                <p><span><em>
+                <!-- comment -->
+                </em>
+                <!-- comment -->
+                </span></p>
+                <!-- comment -->
+                <p><em>bar</em></p>
+                """
+            )
+        )
+
+    def test_comment_after_unclosed_inline_tag_and_blank_line(self):
+        # A blank line ends the paragraph, so the unclosed inline tag no longer applies.
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <span>foo
+
+                <!-- comment -->
+                *bar*
+                """
+            ),
+            self.dedent(
+                """
+                <p><span>foo</p>
+                <!-- comment -->
+                <p><em>bar</em></p>
+                """
+            )
+        )
+
+    def test_processing_instruction_in_inline_raw_html(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <span>
+                <?php echo 'foo'; ?>
+                </span>
+                """
+            ),
+            self.dedent(
+                """
+                <p><span>
+                <?php echo 'foo'; ?>
+                </span></p>
+                """
+            )
+        )
+
