+    // Some different length found, put it in cache as upper limit of where closer can be found.
+    // Never move an entry backwards: a shorter scan (one that ends at a matching
+    // closer) must not hide runs a previous, longer scan already saw further on.
+    if ((state.backticks[closerLength] || 0) < matchStart) {
+      state.backticks[closerLength] = matchStart
+    }
   }
 
