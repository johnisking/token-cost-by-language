+  test("record with numeric keys emits string propertyNames", () => {
+    expect(z.toJSONSchema(z.record(z.number(), z.number())).propertyNames).toEqual({
+      type: "string",
+      pattern: "^-?\\d+(?:\\.\\d+)?$",
+    });
+    // numeric range keywords have no string form and are dropped; integer keys get the integer pattern
+    expect(z.toJSONSchema(z.record(z.int().min(0), z.number())).propertyNames).toEqual({
+      type: "string",
+      pattern: "^-?\\d+$",
+    });
+    expect(z.toJSONSchema(z.record(z.union([z.literal(1), z.literal("a")]), z.number()))).toMatchObject({
+      propertyNames: {
+        anyOf: [
+          { type: "string", const: "1" },
+          { type: "string", const: "a" },
+        ],
+      },
+      required: ["1", "a"],
+    });
+    // a reused key type keeps its numeric schema elsewhere
+    const key = z.number();
+    const json = z.toJSONSchema(z.object({ a: key, b: z.record(key, z.string()) }));
+    expect(json.properties!.a).toEqual({ type: "number" });
+    expect((json.properties!.b as any).propertyNames).toEqual({
+      type: "string",
+      pattern: "^-?\\d+(?:\\.\\d+)?$",
+    });
+  });
+
