+// property names are always strings, and record parsing matches a numeric-string key against Number(key), so a numeric key schema is rewritten to the string form it accepts. returns a copy, since the input may be shared with other users of the key type
+function stringifyPropertyNames(json: JSONSchema.BaseSchema): JSONSchema.BaseSchema {
+  let out = json;
+  const copy = () => {
+    if (out === json) out = { ...json };
+    return out;
+  };
+  for (const key of ["anyOf", "oneOf", "enum"] as const) {
+    const arr = json[key] as (JSONSchema.BaseSchema | string | number | boolean | null)[] | undefined;
+    if (!Array.isArray(arr)) continue;
+    const mapped = arr.map((o) =>
+      typeof o === "number" ? String(o) : typeof o === "object" && o ? stringifyPropertyNames(o) : o
+    );
+    if (mapped.some((o, i) => o !== arr[i])) (copy() as any)[key] = mapped;
+  }
+  if (typeof json.const === "number") copy().const = String(json.const);
+  if (json.type === "number" || json.type === "integer") {
+    const o = copy();
+    // numeric range keywords have no string form
+    for (const key of ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf"]) delete o[key];
+    o.type = "string";
+    // an enum or const already pins the key down, so the pattern is only needed for an open number
+    if (json.const === undefined && !json.enum)
+      o.pattern = (json.type === "integer" ? regexes.integer : regexes.number).source;
+  }
+  return out;
+}
