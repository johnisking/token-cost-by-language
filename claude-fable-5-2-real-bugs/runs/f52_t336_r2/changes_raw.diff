+
+
+def test_integer_preserves_underscores():
+    for raw, value in [("1_000", 1000), ("-5_349_221", -5349221), ("1_2_3", 123)]:
+        i = tomlkit.integer(raw)
+        assert i.as_string() == raw
+        assert int(i) == value
+        assert i == value
+
+    doc = tomlkit.document()
+    doc["n"] = tomlkit.integer("1_000")
+    assert tomlkit.dumps(doc) == "n = 1_000\n"
+    assert tomlkit.parse(tomlkit.dumps(doc))["n"] == 1000
+
+    assert tomlkit.integer("42").as_string() == "42"
+    assert tomlkit.integer(1000).as_string() == "1000"
+    # Not valid TOML (leading zero): fall back to the canonical form
+    assert tomlkit.integer("0_1").as_string() == "1"
