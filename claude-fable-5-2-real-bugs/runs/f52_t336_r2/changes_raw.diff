 def integer(raw: str | int) -> Integer:
     """Create an integer item from a number or string."""
-    return item(int(raw))
+    value = int(raw)
+    if isinstance(raw, str):
+        # Preserve digit grouping (e.g. "1_000") when the string is a valid
+        # TOML decimal integer; otherwise fall back to the canonical form.
+        text = raw.strip()
+        if "_" in text and _GROUPED_INTEGER.match(text):
+            return Integer(value, Trivia(), text)
+
+    return item(value)
+
+
+_GROUPED_INTEGER = re.compile(r"[+-]?[1-9](?:_?[0-9])*\Z")
 
 
