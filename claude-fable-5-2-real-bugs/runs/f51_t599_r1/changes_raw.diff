+@pytest.mark.parametrize(
+    "key",
+    [
+        slice(0, 0),
+        slice(None, 0),
+        slice(-1, None),
+        slice(None, -1),
+        slice(1, -1),
+        slice(-2, 1),
+        slice(None, None, 2),
+        slice(None, None, -1),
+        slice(3, 1, -1),
+        slice(10, 20),
+        slice(-10, 1),
+    ],
+)
+def test_array_del_slice_keeps_rendering_in_sync(key):
+    doc = parse("a = [1, 2, 3, 4]\n")
+    arr = doc["a"]
+    expected = [1, 2, 3, 4]
+    del expected[key]
+    del arr[key]
+    assert list(arr) == expected
+    assert parse(doc.as_string())["a"] == expected
