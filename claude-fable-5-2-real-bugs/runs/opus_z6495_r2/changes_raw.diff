--- a/packages/zod/src/v4/classic/tests/default.test.ts
+++ b/packages/zod/src/v4/classic/tests/default.test.ts
@@ -1,6 +1,22 @@
 import { expect, expectTypeOf, test } from "vitest";
 import { z } from "zod/v4";
 
+test("default and prefault getters run once per object parse", () => {
+  const calls = { d: 0, p: 0 };
+  const schema = z.object({
+    d: z.string().default(() => {
+      calls.d++;
+      return "d";
+    }),
+    p: z.string().prefault(() => {
+      calls.p++;
+      return "p";
+    }),
+  });
+  expect(schema.parse({})).toEqual({ d: "d", p: "p" });
+  expect(calls).toEqual({ d: 1, p: 1 });
+});
+
 test("basic defaults", () => {
   expect(z.string().default("default").parse(undefined)).toBe("default");
 });
