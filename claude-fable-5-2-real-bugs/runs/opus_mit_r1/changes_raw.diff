+    def test_float_consistency(self):
+        # len(), indexing, reversed(), `in`, index() and count() must agree
+        # with the items that iteration produces, even with float rounding.
+        for args, expected_len in [
+            ((-8.732, -13.532, -2.4), 2),
+            ((-69.37276490678778, -29.8339073344664, 4.942357196540172), 9),
+            ((0.0, 1.0, 0.1), 10),
+            ((1.0, 0.0, -0.1), 10),
+        ]:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                items = list(r)
+                self.assertEqual(len(items), expected_len)
+                self.assertEqual(len(r), expected_len)
+                self.assertEqual(list(reversed(r)), items[::-1])
+                with self.assertRaises(IndexError):
+                    r[len(items)]
+                for i, v in enumerate(items):
+                    self.assertEqual(r[i], v)
+                    self.assertIn(v, r)
+                    self.assertEqual(r.index(v), i)
+                    self.assertEqual(r.count(v), 1)
+                self.assertNotIn(args[1], r)
+
