     e2 = expr.copy()
     rep <<= e2
 
+    # Matches of expr and of the repeater are tracked as a list of events,
+    # ordered by location in the string being parsed. Each event is a tuple
+    # (loc, is_repeat, open_stack, last_tokens), where open_stack is a linked
+    # list (tokens, parent) of the matches of expr that have not yet been
+    # "closed" by a matching repeat, and last_tokens are the tokens of the most
+    # recent match of expr. Keeping the stack makes nested constructs such as
+    # "{a}{b}..{/b}{/a}" work; events found at or after the current location
+    # are leftovers from lookahead or abandoned alternatives and are dropped.
+    events: list = []
+    current_string: list = [None]
+
+    def discard_events_from(s, l, keep_first_at_loc):
+        if current_string[0] != s:
+            current_string[0] = s
+            del events[:]
+        while events and (
+            events[-1][0] > l
+            or (events[-1][0] == l and not (keep_first_at_loc and not events[-1][1]))
+        ):
+            events.pop()
+
     def copy_token_to_repeater(s, l, t):
         match_tokens = _flatten(t.as_list())
