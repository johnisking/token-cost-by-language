-
+        discard_events_from(s, l, False)
+        open_stack = events[-1][2] if events else None
+        events.append((l, False, (match_tokens, open_stack), match_tokens))
+
+    def must_match_these_tokens(s, l, t):
+        discard_events_from(s, l, True)
+        if not events:
+            # no previous match to compare with
+            return
+        _, _, open_stack, last_tokens = events[-1]
+        match_tokens = open_stack[0] if open_stack else last_tokens
+        these_tokens = _flatten(t.as_list())
+        if these_tokens != match_tokens:
+            raise ParseException(s, l, f"Expected {match_tokens}, found{these_tokens}")
+        events.append((l, True, open_stack[1] if open_stack else None, last_tokens))
+
+    e2.add_parse_action(must_match_these_tokens, call_during_try=True)
     expr.add_parse_action(copy_token_to_repeater, call_during_try=True)
