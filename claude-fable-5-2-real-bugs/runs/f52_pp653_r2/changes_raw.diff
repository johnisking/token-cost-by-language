+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr with nested, sequential and repeated parses"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        opener = pp.Suppress("{") + name + pp.Suppress("}")
+        closer = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        item = pp.Forward()
+        item <<= pp.Group(opener + pp.ZeroOrMore(item | pp.Word("x")) + closer)
+
+        tests = [
+            ("{a}xx{/a}", [["a", "xx", "a"]]),
+            ("{a}{b}xx{/b}{/a}", [["a", ["b", "xx", "b"], "a"]]),
+            ("{a}{b}xx{/a}{/b}", None),
+            ("{a}xx{/b}", None),
+            (
+                "{a}{b}xx{/b}{c}x{/c}{/a}",
+                [["a", ["b", "xx", "b"], ["c", "x", "c"], "a"]],
+            ),
+            ("{a}{b}xx{/b}{c}x{/c}{/b}", None),
+            # valid input must still parse after earlier failures
+            ("{a}xx{/a}", [["a", "xx", "a"]]),
+        ]
+        for tst, expected in tests:
+            with self.subTest(tst=tst):
+                if expected is not None:
+                    self.assertParseAndCheckList(item, tst, expected)
+                else:
+                    with self.assertRaisesParseException():
+                        item.parse_string(tst, parse_all=True)
+
+        first = pp.Word(pp.nums)
+        second = pp.match_previous_expr(first)
+        pairs = pp.OneOrMore(first + pp.Suppress(":") + second)
+        for tst, expected in [
+            ("1:1 2:2", ["1", "1", "2", "2"]),
+            ("1:2", None),
+            ("1:1 2:3", None),
+            ("1:1 2:2 3:3", ["1", "1", "2", "2", "3", "3"]),
+        ]:
+            with self.subTest(tst=tst):
+                if expected is not None:
+                    self.assertParseAndCheckList(pairs, tst, expected)
+                else:
+                    with self.assertRaisesParseException():
+                        pairs.parse_string(tst, parse_all=True)
+
+        # more than one repeat of a single match
+        triple = first + ":" + second + ":" + second
+        self.assertParseAndCheckList(triple, "1:1:1", ["1", ":", "1", ":", "1"])
+        with self.assertRaisesParseException():
+            triple.parse_string("1:1:2", parse_all=True)
+
