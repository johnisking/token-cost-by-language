+    def testRepeaterNestedAndRepeated(self):
+        """test match_previous_expr with nested, repeated, and re-parsed matches"""
+
+        if ParserElement._packratEnabled or ParserElement._left_recursion_enabled:
+            print("skipping this test, not compatible with memoization")
+            return
+
+        name = pp.Word(pp.alphas)
+        open_tag = pp.Suppress("{") + name + pp.Suppress("}")
+        close_tag = pp.Suppress("{/") + pp.match_previous_expr(name) + pp.Suppress("}")
+        element = pp.Forward()
+        element <<= pp.Group(
+            open_tag + pp.ZeroOrMore(element | pp.Word("x")) + close_tag
+        )
+        doc = pp.OneOrMore(element)
+
+        # simple
+        self.assertParseAndCheckList(doc, "{a}xx{/a}", [["a", "xx", "a"]])
+        # nested
+        self.assertParseAndCheckList(
+            doc, "{a}{b}xx{/b}{/a}", [["a", ["b", "xx", "b"], "a"]]
+        )
+        # sequential
+        self.assertParseAndCheckList(
+            doc, "{a}xx{/a}{b}xx{/b}", [["a", "xx", "a"], ["b", "xx", "b"]]
+        )
+        # mismatched tags must fail
+        with self.assertRaisesParseException():
+            doc.parse_string("{a}xx{/b}", parse_all=True)
+        with self.assertRaisesParseException():
+            doc.parse_string("{a}{b}xx{/a}{/b}", parse_all=True)
+        # valid input still parses after failed parses
+        self.assertParseAndCheckList(doc, "{b}xx{/b}", [["b", "xx", "b"]])
+        self.assertParseAndCheckList(
+            doc, "{a}{b}xx{/b}{/a}", [["a", ["b", "xx", "b"], "a"]]
+        )
+
+        # repeater used more than once after a single match
+        first = pp.Word(pp.nums)
+        second = pp.match_previous_expr(first)
+        expr = first + ":" + second + ":" + second
+        self.assertParseAndCheckList(expr, "1:1:1", ["1", ":", "1", ":", "1"])
+        with self.assertRaisesParseException():
+            expr.parse_string("1:1:2", parse_all=True)
+
