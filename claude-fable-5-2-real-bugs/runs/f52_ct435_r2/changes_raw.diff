+class _Unbound:
+    """Wrapper returned when a cached method is accessed through its class.
+
+    Behaves like an unbound method, i.e. the instance has to be passed
+    explicitly as the first argument.
+
+    """
+
+    def __init__(self, descriptor):
+        # copies the method's metadata as well as the descriptor's
+        # cache, cache_key, cache_lock and cache_condition functions
+        functools.update_wrapper(self, descriptor)
+        self.__descriptor = descriptor
+
+    def __bound(self, obj):
+        return self.__descriptor.__get__(obj, type(obj))
+
+    def __call__(self, obj, /, *args, **kwargs):
+        return self.__bound(obj)(*args, **kwargs)
+
+    def cache_clear(self, obj):
+        return self.__bound(obj).cache_clear()
+
+    def cache_info(self, obj):
+        return self.__bound(obj).cache_info()
+
+
