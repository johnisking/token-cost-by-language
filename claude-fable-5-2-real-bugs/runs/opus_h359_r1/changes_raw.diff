diff --git a/src/humanize/number.py b/src/humanize/number.py
index 2dfeffe..c05cc5d 100644
--- a/src/humanize/number.py
+++ b/src/humanize/number.py
@@ -550,8 +550,13 @@ def metric(value: float, unit: str = "", precision: int = 3) -> str:
     old_bucket = exponent // 3 * 3
     value /= 10**old_bucket
     digits = int(max(0, precision - exponent % 3 - 1))
-    if exponent < 30 and round(abs(value), digits) >= 1000:
-        exponent += 3 - exponent % 3
+    # Rounding may carry the mantissa up a power of ten (e.g. 9.999 -> 10.00),
+    # in which case one fewer decimal digit is needed to keep `precision`
+    # significant figures, and possibly a larger SI prefix (999.9 -> 1.00 k).
+    if round(abs(value), digits) >= 10 ** (exponent % 3 + 1) and not (
+        exponent >= 30 and exponent % 3 == 2
+    ):
+        exponent += 1
         new_bucket = exponent // 3 * 3
         value /= 10 ** (new_bucket - old_bucket)
         digits = int(max(0, precision - exponent % 3 - 1))
