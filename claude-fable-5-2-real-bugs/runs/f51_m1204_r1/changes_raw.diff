diff --git a/src/markdownit.ts b/src/markdownit.ts
index 4dc2ce9..043cbd8 100644
--- a/src/markdownit.ts
+++ b/src/markdownit.ts
@@ -162,7 +162,25 @@ class MarkdownIt {
       }
     }
 
-    return mdurl.encode(mdurl.format(parsed))
+    const formatted = mdurl.format(parsed)
+
+    // IPv6 address literals must keep their enclosing brackets
+    // (`http://[::1]/`), otherwise browsers reject the host. Encode the
+    // parts around the host separately so brackets elsewhere in the url
+    // (e.g. in the path or query) are still percent-encoded.
+    if (parsed.hostname && parsed.hostname.indexOf(':') >= 0) {
+      const literal = `[${parsed.hostname}]`
+      const start = formatted.indexOf(literal)
+
+      if (start >= 0) {
+        const end = start + literal.length
+        return mdurl.encode(formatted.slice(0, start)) +
+               literal +
+               mdurl.encode(formatted.slice(end))
+      }
+    }
+
+    return mdurl.encode(formatted)
   }
 
   /**
