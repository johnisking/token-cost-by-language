     def _to_linecol(self) -> tuple[int, int]:
         cur = 0
-        for i, line in enumerate(self.splitlines()):
-            if cur + len(line) + 1 > self.idx:
-                return (i + 1, self.idx - cur)
-
-            cur += len(line) + 1
-
-        return len(self.splitlines()), 0
+        lines = self.splitlines(keepends=True)
+        for i, line in enumerate(lines):
+            # Line content without its terminator (which may be "\n", "\r\n",
+            # "\r", ...), so that positions do not depend on line endings.
+            content_len = len(line.splitlines()[0]) if line else 0
+            # The position of the terminator (or end of input for the last
+            # line) belongs to this line, as with "\n" line endings.
+            if self.idx < cur + len(line) or self.idx <= cur + content_len:
+                return (i + 1, min(self.idx - cur, content_len))
+
+            cur += len(line)
+
+        return len(lines), 0
