+    def test_comment_in_inline_raw_html(self):
+        # A comment nested in inline (non-block-level) raw HTML must not split the paragraph.
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                <picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture>
+                """
+            ),
+            self.dedent(
+                """
+                <p><picture>
+                  <!-- TODO: what the heck? -->
+                  <source media="(prefers-color-scheme: dark)" srcset="../images/example.svg">
+                  <img alt="Example" src="../images/example.svg">
+                </picture></p>
+                """
+            )
+        )
+
