+    def at_block_start(self) -> bool:
+        """
+        Returns True if the content already extracted to `cleandoc` ends at a block boundary.
+
+        That is, `cleandoc` is empty or ends with a blank line (ignoring any indentation
+        on the current line). Used to distinguish an item which starts a new block from one
+        which is a continuation of a paragraph (e.g. a comment nested in inline raw HTML).
+        """
+        text = ''
+        for item in reversed(self.cleandoc):
+            text = item + text
+            if text.strip(' \t\n'):
+                # Found non-whitespace content preceding the current line.
+                return text.rstrip(' \t').endswith('\n\n')
+        # Nothing but whitespace precedes the current line.
+        return True
+
