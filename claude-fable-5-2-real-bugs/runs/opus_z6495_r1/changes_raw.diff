@@ -56,6 +56,8 @@ function isRecursive(inst: $ZodType, stack: Set<object>): boolean {
     // `for...in` skips symbols, so a cycle through a declared symbol key would read as non-recursive
     if (shape) for (const key of Reflect.ownKeys(shape)) check(shape[key]);
     for (const key in def) {
+      // accessors can run user code (a `.default()` factory), so only data properties are walked
+      if (Object.getOwnPropertyDescriptor(def, key)?.get) continue;
       const value = def[key];
       if (!value || typeof value !== "object") continue;
       if (value._zod) check(value);
