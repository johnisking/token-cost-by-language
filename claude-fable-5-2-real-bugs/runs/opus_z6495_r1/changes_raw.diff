index d7ff8b4..2f8a6e8 100644
--- a/packages/zod/src/v4/classic/tests/default.test.ts
+++ b/packages/zod/src/v4/classic/tests/default.test.ts
@@ -5,6 +5,26 @@ test("basic defaults", () => {
   expect(z.string().default("default").parse(undefined)).toBe("default");
 });
 
+test("default factory runs once per parse inside an object", () => {
+  let calls = 0;
+  const factory = () => {
+    calls++;
+    return "d";
+  };
+  const schema = z.object({ a: z.string().default(factory), b: z.string().prefault(factory) });
+  expect(schema.parse({})).toEqual({ a: "d", b: "d" });
+  expect(calls).toBe(2);
+  expect(schema.parse({ a: "x", b: "y" })).toEqual({ a: "x", b: "y" });
+  expect(calls).toBe(2);
+});
+
+test("merge keeps a recursive catchall detectable", () => {
+  const Node: z.ZodType = z.lazy(() => z.object({}).merge(z.object({}).catchall(Node)));
+  const value: any = {};
+  value.self = value;
+  expect(() => Node.parse(value)).not.toThrow();
+});
+
 test("default with optional", () => {
   const schema = z.string().optional().default("default");
   expect(schema.parse(undefined)).toBe("default");
