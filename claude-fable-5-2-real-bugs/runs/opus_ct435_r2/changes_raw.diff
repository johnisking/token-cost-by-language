+class ClassAccessTest(unittest.TestCase):
+    NAMES = (
+        "get",
+        "get_typed",
+        "get_info",
+        "get_lock",
+        "get_lock_info",
+        "get_cond",
+        "get_cond_info",
+        "get_lock_cond",
+        "get_lock_cond_info",
+    )
+
+    def test_class_access_with_instance(self):
+        for name in self.NAMES:
+            with self.subTest(name=name):
+                cached = Cached(Cache(2))
+                unbound = getattr(Cached, name)
+                self.assertEqual(unbound(cached, 0), 0)
+                self.assertEqual(getattr(cached, name)(0), 0)
+                self.assertEqual(unbound(cached, 0), 0)
+                self.assertEqual(unbound(cached, 1), 1)
+                self.assertEqual(getattr(cached, name)(1), 1)
+                self.assertEqual(len(cached.cache), 2)
+                if name.endswith("_info"):
+                    info = getattr(cached, name).cache_info()
+                    self.assertEqual(info.hits, 3)
+                    self.assertEqual(info.misses, 2)
+
+    def test_class_access_without_instance(self):
+        with self.assertRaises(TypeError):
+            Cached.get()
+
+    def test_class_access_introspection(self):
+        self.assertEqual(Cached.get.__name__, "get")
+        self.assertEqual(Cached.get.__doc__, "docstring")
+
+
