+  /**
+   * Mask reference links so their text cannot close em, strong or del.
+   * A reference link whose text holds another link is rejected by the
+   * tokenizer ("links may not contain other links") and its text is re-scanned
+   * as ordinary inline content, so only the links inside it are masked.
+   */
+  private maskReflinks(src: string): string {
+    const links = this.tokens.links;
+    return src.replace(this.tokenizer.rules.inline.reflinkSearch, (match0) => {
+      if (!Object.hasOwn(links, match0.slice(match0.lastIndexOf('[') + 1, -1))) {
+        return match0;
+      }
+      // only a link (not an image) with a bracket in its text can be rejected
+      if (match0.charAt(0) !== '!' && match0.indexOf('[', 1) < match0.lastIndexOf('[')) {
+        const { inLink, inRawBlock, linkEmitted } = this.state;
+        let rejected = false;
+        try {
+          rejected = !this.tokenizer.reflink(match0, links);
+        } finally {
+          this.state.inLink = inLink;
+          this.state.inRawBlock = inRawBlock;
+          this.state.linkEmitted = linkEmitted;
+        }
+        if (rejected) {
+          // the opening bracket becomes text; mask what follows it on its own
+          return '[' + this.maskReflinks(match0.slice(1));
+        }
+      }
+      return '[' + 'a'.repeat(match0.length - 2) + ']';
+    });
+  }
+
