@@ -93,3 +93,38 @@ test xn--n3h@xn--n3h.net foo
 .
 <p>test <a href="mailto:xn--n3h@xn--n3h.net">xn--n3h@☃.net</a> foo</p>
 .
+
+
+Keep brackets of IPv6 address literals, but encode brackets elsewhere:
+
+.
+[visit](http://[2001:db8::1]/)
+.
+<p><a href="http://[2001:db8::1]/">visit</a></p>
+.
+
+.
+[visit](https://user@[::1]:8080/a[b]?c[d]=[e]#[f])
+.
+<p><a href="https://user@[::1]:8080/a%5Bb%5D?c%5Bd%5D=%5Be%5D#%5Bf%5D">visit</a></p>
+.
+
+.
+<http://[::ffff:192.0.2.1]/α>
+.
+<p><a href="http://[::ffff:192.0.2.1]/%CE%B1">http://[::ffff:192.0.2.1]/α</a></p>
+.
+
+.
+[ref]
+
+[ref]: http://[2001:db8::1]/x
+.
+<p><a href="http://[2001:db8::1]/x">ref</a></p>
+.
+
+.
+[visit](http://[foo]/[bar])
+.
+<p><a href="http://foo/%5Bbar%5D">visit</a></p>
+.
