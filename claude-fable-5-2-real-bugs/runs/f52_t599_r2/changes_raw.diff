+
+
+@pytest.mark.parametrize(
+    "key",
+    [
+        slice(None, 0),
+        slice(-1, None),
+        slice(None, -1),
+        slice(0, 0),
+        slice(1, 100),
+        slice(-100, 2),
+        slice(None, None, -1),
+        slice(None, None, 2),
+        slice(3, 0, -2),
+        slice(None),
+    ],
+)
+def test_array_delete_slice_keeps_string_in_sync(key):
+    doc = parse("a = [1, 2, 3, 4]\n")
+    expected = [1, 2, 3, 4]
+    del expected[key]
+    del doc["a"][key]
+    assert list(doc["a"]) == expected
+    assert parse(doc.as_string())["a"] == expected
