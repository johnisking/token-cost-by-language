+  /**
+   * Whether a link label contains an inline link or a resolvable reference link
+   * (images are not links).
+   */
+  labelHasLink(label: string): boolean {
+    if (!label.includes('[')) {
+      return false;
+    }
+    const { linkSearch, reflinkSearch } = this.tokenizer.rules.inline;
+    for (const match of label.matchAll(linkSearch)) {
+      if (match[0].charAt(0) !== '!') {
+        return true;
+      }
+    }
+    for (const match of label.matchAll(reflinkSearch)) {
+      const match0 = match[0];
+      if (match0.charAt(0) !== '!'
+        && Object.hasOwn(this.tokens.links, match0.slice(match0.lastIndexOf('[') + 1, -1))) {
+        return true;
+      }
+    }
+    return false;
+  }
