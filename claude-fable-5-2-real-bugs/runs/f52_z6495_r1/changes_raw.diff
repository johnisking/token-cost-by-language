 });
+
+test("default function runs once per parse inside an object", () => {
+  const def = vi.fn(() => "d");
+  const pre = vi.fn(() => "p");
+  const schema = z.object({ a: z.string().default(def), b: z.string().prefault(pre) });
+  expect(schema.parse({})).toEqual({ a: "d", b: "p" });
+  expect(def).toHaveBeenCalledTimes(1);
+  expect(pre).toHaveBeenCalledTimes(1);
+  schema.parse({});
+  expect(def).toHaveBeenCalledTimes(2);
+});
