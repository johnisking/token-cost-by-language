+// json property names are always strings, so numeric keys are described by their string form
+function acceptsNumber(js: JSONSchema.BaseSchema): boolean {
+  const type = js.type;
+  if (type === "number" || type === "integer") return true;
+  if (Array.isArray(type) && (type.includes("number") || type.includes("integer"))) return true;
+  if (typeof js.const === "number" || js.enum?.some((v) => typeof v === "number")) return true;
+  return !!(js.anyOf?.some(acceptsNumber) || js.oneOf?.some(acceptsNumber));
+}
+
+function numericKeyNames(keyType: schemas.$ZodType): JSONSchema.BaseSchema {
+  const values = keyType._zod.values;
+  if (values) {
+    const names = [...values].filter((v) => typeof v === "string" || typeof v === "number").map(String);
+    return { type: "string", enum: [...new Set(names)] };
+  }
+  const pattern = keyType._zod.pattern;
+  return pattern ? { type: "string", pattern: pattern.source } : { type: "string" };
+}
