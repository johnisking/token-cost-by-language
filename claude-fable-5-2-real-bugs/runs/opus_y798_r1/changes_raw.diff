+  it('forceQuotes — leaves non-string scalars plain and untagged', () => {
+    const data = { bool: true, integer: 42, float: 3.14, nil: null, text: 'true' }
+    const out = dump(data, { forceQuotes: true, quoteStyle: 'double' })
+    assert.equal(out, 'bool: true\ninteger: 42\nfloat: 3.14\nnil: null\ntext: "true"\n')
+    assert.deepEqual(load(out), data)
+    assert.equal(dump([false, 1, 'x'], { forceQuotes: true }), "- false\n- 1\n- 'x'\n")
+  })
+
   it('flowLevel — switches to flow style from the given depth', () => {
     assert.equal(dump({ a: [1, 2] }), 'a:\n  - 1\n  - 2\n')
     assert.equal(dump({ a: [1, 2] }, { flowLevel: 0 }), '{a: [1, 2]}\n')
