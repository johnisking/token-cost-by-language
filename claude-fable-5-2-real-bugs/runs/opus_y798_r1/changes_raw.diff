diff --git a/src/ast/styler_defaults.ts b/src/ast/styler_defaults.ts
index d61ce64..395be01 100644
--- a/src/ast/styler_defaults.ts
+++ b/src/ast/styler_defaults.ts
@@ -64,6 +64,12 @@ function applyForceQuotesOption (layout: ScalarLayout): void {
   // forceQuotes applies only to plain values, not to mapping keys.
   if (layout.isKey || layout.style !== SCALAR_STYLE.PLAIN) return
 
+  // Only strings are force-quoted. Untagged scalars of other implicit types
+  // (bool, int, float, null, ...) stay plain; quoting them would require an
+  // explicit tag to preserve their type.
+  const node = layout.node
+  if (!node.tagged && node.tag !== layout.presenterOptions.schema.defaultScalarTag.tagName) return
+
   layout.style = layout.node.value.includes('\n')
     ? SCALAR_STYLE.DOUBLE_QUOTED
     : _preferredQuotedStyle(layout)
