+// Hostname of an IPv6 address literal (brackets already stripped by parser),
+// including the form with an embedded IPv4 address (`::ffff:192.0.2.1`).
+const IPV6_HOSTNAME_RE = /^(?=[^:]*:)[0-9a-f:.]+$/i
