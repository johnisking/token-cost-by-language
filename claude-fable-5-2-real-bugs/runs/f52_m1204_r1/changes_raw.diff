+      const hostPos = (parsed.protocol || '').length +
+        (parsed.slashes ? 2 : 0) +
+        (parsed.auth ? parsed.auth.length + 1 : 0)
+
+      if (formatted.slice(hostPos, hostPos + host.length) === host) {
+        return mdurl.encode(formatted.slice(0, hostPos)) +
