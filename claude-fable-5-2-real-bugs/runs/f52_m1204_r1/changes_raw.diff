+    if (parsed.hostname && IPV6_HOSTNAME_RE.test(parsed.hostname)) {
+      // IPv6 address literal: `mdurl.format()` wraps it in square brackets,
+      // which are host delimiters here and must not be percent-encoded
+      // (`http://%5B::1%5D/` is not a valid url). Encode everything around
