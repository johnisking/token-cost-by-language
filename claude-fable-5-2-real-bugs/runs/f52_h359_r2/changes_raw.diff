+    [
+        ([9999], "10.0 k"),
+        ([99999], "100 k"),
+        ([9.99999], "10.0"),
+        ([-9999], "-10.0 k"),
+        ([99.99], "100"),
+        ([0.0099999], "10.0 m"),
+        ([0.99999], "1.00"),
+        ([999999], "1.00 M"),
+        ([9.99, "V"], "9.99 V"),
+        ([9.996, "V", 4], "9.996 V"),
+        ([9.9996, "V", 4], "10.00 V"),
+        ([999, "", 1], "999"),
+        ([9.5, "", 1], "10"),
+    ],
+)
+def test_metric_rounding_carry(test_args: list[typing.Any], expected: str) -> None:
