diff --git a/src/humanize/number.py b/src/humanize/number.py
index 2dfeffe..4b7ca92 100644
--- a/src/humanize/number.py
+++ b/src/humanize/number.py
@@ -550,11 +550,17 @@ def metric(value: float, unit: str = "", precision: int = 3) -> str:
     old_bucket = exponent // 3 * 3
     value /= 10**old_bucket
     digits = int(max(0, precision - exponent % 3 - 1))
-    if exponent < 30 and round(abs(value), digits) >= 1000:
+    rounded = round(abs(value), digits)
+    if exponent < 30 and rounded >= 1000:
         exponent += 3 - exponent % 3
         new_bucket = exponent // 3 * 3
         value /= 10 ** (new_bucket - old_bucket)
         digits = int(max(0, precision - exponent % 3 - 1))
+    elif exponent % 3 != 2 and rounded >= 10 ** (exponent % 3 + 1):
+        # Rounding carried the mantissa up a power of ten within the same
+        # prefix bucket (e.g. 9.999 -> 10.0), so one fewer decimal is needed.
+        exponent += 1
+        digits = int(max(0, precision - exponent % 3 - 1))
 
     if exponent >= 3:
         ordinal_ = "kMGTPEZYRQ"[exponent // 3 - 1]
