@@ -36,6 +36,9 @@ class StateInline {
   // backtick length => last seen position
   backticks: Record<number, number> = {}
   backticksScanned = false
+  // Smallest position from which a failed backtick scan reached the end of
+  // the source. The cache above is only complete for positions >= this one.
+  backticksScannedFrom = Infinity
 
   // Counter used to disable inline linkify-it execution
