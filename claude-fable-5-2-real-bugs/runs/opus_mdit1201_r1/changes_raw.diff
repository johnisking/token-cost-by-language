diff --git a/src/rules_inline/backticks.ts b/src/rules_inline/backticks.ts
index 9fd05dc..ee521d4 100644
--- a/src/rules_inline/backticks.ts
+++ b/src/rules_inline/backticks.ts
@@ -18,7 +18,12 @@ export default function backtick (state: StateInline, silent: boolean): boolean
   const marker = state.src.slice(start, pos)
   const openerLength = marker.length
 
-  if (state.backticksScanned && (state.backticks[openerLength] || 0) <= start) {
+  // The cache is only trustworthy if a full scan to the end of the source
+  // started at or before this position (scans can happen out of order,
+  // e.g. when a link label is validated via skipToken).
+  if (state.backticksScanned &&
+      start >= state.backticksScannedFrom &&
+      (state.backticks[openerLength] || 0) <= start) {
     if (!silent) state.pending += marker
     state.pos += openerLength
     return true
@@ -50,11 +55,15 @@ export default function backtick (state: StateInline, silent: boolean): boolean
     }
 
     // Some different length found, put it in cache as upper limit of where closer can be found
-    state.backticks[closerLength] = matchStart
+    // (keep the largest position, so a later partial scan can't shrink it)
+    if ((state.backticks[closerLength] || 0) < matchStart) {
+      state.backticks[closerLength] = matchStart
+    }
   }
 
   // Scanned through the end, didn't find anything
   state.backticksScanned = true
+  if (start < state.backticksScannedFrom) state.backticksScannedFrom = start
 
   if (!silent) state.pending += marker
   state.pos += openerLength
diff --git a/src/rules_inline/state_inline.ts b/src/rules_inline/state_inline.ts
