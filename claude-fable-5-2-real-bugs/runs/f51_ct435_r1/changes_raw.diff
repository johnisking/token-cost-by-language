+    def __unbound_wrapper(self):
+        # Wrapper returned when the descriptor is accessed through the
+        # class, e.g. `Class.method`.  Like a plain function, calling it
+        # requires the instance to be passed explicitly as the first
+        # positional argument, and the call is routed through the
+        # instance's own (bound) wrapper so the instance's cache is used.
+        if self.__unbound is None:
+            descriptor = self
+
+            class Unbound(self.Wrapper):  # type: ignore
+                def __init__(self):
+                    super().__init__(None)
+
+                def __call__(self, obj, /, *args, **kwargs):
+                    return descriptor.__get__(obj, type(obj))(*args, **kwargs)
+
+            self.__unbound = Unbound()
+        return self.__unbound
 
