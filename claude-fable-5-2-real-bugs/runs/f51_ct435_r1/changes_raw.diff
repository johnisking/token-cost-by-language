+class ClassAccessTest(unittest.TestCase):
+    METHODS = [
+        "get",
+        "get_typed",
+        "get_info",
+        "get_lock",
+        "get_lock_info",
+        "get_cond",
+        "get_cond_info",
+        "get_lock_cond",
+        "get_lock_cond_info",
+    ]
+
+    def test_explicit_instance(self):
+        for name in self.METHODS:
+            with self.subTest(name=name), warnings.catch_warnings():
+                warnings.simplefilter("error")
+                cached = Cached(Cache(2))
+                unbound = getattr(Cached, name)
+                self.assertIs(unbound, getattr(Cached, name))
+                self.assertEqual(unbound.__name__, name)
+                # class access behaves like instance access, sharing its cache
+                self.assertEqual(unbound(cached, 1), 0)
+                self.assertEqual(unbound(cached, 1), 0)
+                self.assertEqual(getattr(cached, name)(1), 0)
+                self.assertEqual(getattr(cached, name)(2), 1)
+                self.assertEqual(unbound(cached, 2), 1)
+                self.assertEqual(len(cached.cache), 2)
+                self.assertEqual(cached.count, 2)
+                if name.endswith("_info"):
+                    info = getattr(cached, name).cache_info()
+                    self.assertEqual(info.hits, 3)
+                    self.assertEqual(info.misses, 2)
+                getattr(cached, name).cache_clear()
+                self.assertEqual(unbound(cached, 1), 2)
+
+    def test_explicit_instance_kwargs(self):
+        cached = Cached(Cache(2))
+        self.assertEqual(Cached.get(cached, value=1), 0)
+        self.assertEqual(cached.get(value=1), 0)
+        self.assertEqual(cached.get(1), 1)
+
+
